          "value": 0.3
        }
      ]
    },
    {
      "id": "yixuan-mindscape_1-spiritual_path",
      "source": "mindscape",
      "sourceId": "yixuan-mindscape_1",
      "label": "Spiritual Path (Mindscape Cinema N°1)",
      "description": "Upon entering combat, CRIT Rate increases by 10% and immediately gain 120 Technique Points. In Investigation Zone Mode, this effect can only trigger once every 180s. When any squad member lands a hit on an enemy, Yixuan automatically summons an extra lightning strike, dealing DMG equal to 50% of her Sheer Force and restoring 5 additional Adrenaline. This can trigger once every 6s.",
      "shortDescription": "Yixuan's CRIT Rate is increased by 10%. Yixuan's additional damage is available in the Damage Calculator.",
      "target": "self",
      "flat": {
        "critRate": 0.1
      }
    },
    {
      "id": "yixuan-mindscape_2-ward_off_misfortune",
      "source": "mindscape",
      "sourceId": "yixuan-mindscape_2",
      "label": "Ward Off Misfortune (Mindscape Cinema N°2)",
      "description": "When an Ultimate or EX Special Attack deals DMG, it ignores 15% of the target's Ether RES. Triggering Ultimate: Qingming Skyshade extends all enemies' Stunned state by 3s. In a single Stun state duration, enemies can only have this effect applied once, and it does not stack with similar effects.\n\nAdditionally, when using Ultimate: Endless Talisman Suppression, gain one stack of the Condensed Ink effect After Basic Attack: Qingming Eruption or EX Special Attack: Ashen Ink Becomes Shadows, press the Basic Attack button, or after EX Special Attack: Qingming Eruption - Break, press the Special Attack button to consume one stack of Condensed Ink and launch EX Special Attack: Endless Talisman Suppression - Break, dealing DMG up to 1,200% of Sheer Force. Only one stack of Condensed Ink can be held at a time.",
      "shortDescription": "Yixuan's DMG from Ultimates and EX Special Attacks ignore 15% of the target's Ether RES. Yixuan's additional damage is available in the Damage Calculator.",
      "target": "self",
      "exclusiveStatBonuses": [
        {
          "stat": "etherResShred",
          "type": "exclusive",
          "appliesTo": [
            "yixuan-ex_special_attack-ink_manifestation",
            "yixuan-ex_special_attack-cloud_shaper",
            "yixuan-ex_special_attack-ashen_ink_becomes_shadows",
            "yixuan-ultimate-qingming_skyshade",
            "yixuan-ultimate-endless_talisman_suppression",
            "yixuan-mindscape-ward_off_misfortune"
          ],
          "value": 0.15
        }
      ]
    },
    {
      "id": "yixuan-mindscape_4-the_one_path_of_mysticism",
      "source": "mindscape",
      "sourceId": "yixuan-mindscape_4",
      "label": "The One Path of Mysticism (Mindscape Cinema N°4)",
      "description": "Activating an Ultimate grants one stack of Tranquility, up to a max of 2 stacks. For each stack of Tranquility, the next EX Special Attack: Cloud-Shaper DMG and EX Special Attack: Ashen Ink Becomes Shadows DMG increase by 30%.",
      "shortDescription": "Yixuan's DMG from EX Special Attack: Cloud-Shaper and EX Special Attack: Ashen Ink Becomes Shadows is increased by 30%, stacking up to 2 times.",
      "target": "self",
      "damageBonuses": [
        {
          "type": "exclusive",
          "appliesTo": [
            "yixuan-ex_special_attack-cloud_shaper",
            "yixuan-ex_special_attack-ashen_ink_becomes_shadows"
          ],
          "value": 0.3
        }
      ],
      "maxStacks": 2
    },
    {
      "id": "yixuan-mindscape_6-swift_yet_still",
      "source": "mindscape",
      "sourceId": "yixuan-mindscape_6",
      "label": "Swift Yet Still (Mindscape Cinema N°6)",
      "description": "After using Ultimate: Qingming Skyshade, gain a stack of the Regulated Breathing effect. While under this effect, you can ignore the Technique Point cost to launch Ultimate: Endless Talisman Suppression once. The Regulated Breathing effect ends after Ultimate: Endless Talisman Suppression is used. This effect can only be gained once every 30s. Only one stack of Regulated Breathing can be held. Additionally, while in the Meditation state, Yixuan's Sheer DMG is increased by 20%.",
      "shortDescription": "Yixuan's Sheer DMG is increased by 20%.",
      "target": "self",
      "damageBonuses": [
        {
          "type": "sheerDmg",
          "value": 0.2
        }
      ]
    }
