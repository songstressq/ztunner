    },
    {
      "id": "yixuan-core_2-aurik_ink_undercurrent",
      "source": "core",
      "sourceId": "yixuan-core",
      "label": "Auric Ink Undercurrent (Additional Ability)",
      "description": "... EX Special Attack: Cloud-Shaper and EX Special Attack: Ashen Ink Becomes Shadows deal 30% increased DMG to Stunned enemies. ...",
      "shortDescription": "Yixuan's DMG from EX Special Attack: Cloud-Shaper and EX Special Attack: Ashen Ink Becomes Shadows is increased by 30%.",
      "target": "self",
      "damageBonuses": [
        {
          "type": "exclusive",
          "appliesTo": [
            "yixuan-ex_special_attack-cloud_shaper",
            "yixuan-ex_special_attack-ashen_ink_becomes_shadows"
