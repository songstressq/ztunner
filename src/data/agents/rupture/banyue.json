    },
    {
      "id": "banyue-mindscape_2-anger_cuts_like_a_blade",
      "source": "mindscape",
      "sourceId": "banyue-mindscape_2",
      "label": "Anger Cuts Like a Blade (Mindscape Cinema N°2)",
      "description": "The CRIT DMG bonus from the Core Passive is increased by an additional 15%, and the Fire DMG bonus is increased by an additional 15%. While in the Visage of Wrath state, Banyue restores an additional 5 Adrenaline when consuming Mountain's Might to unleash an EX Special Attack.",
      "shortDescription": "Banyue's Fire DMG is further increased by 15% and CRIT DMG is further increased by 15%.",
      "target": "self",
      "flat": {
        "critDmg": 0.15
      },
      "damageBonuses": [
        {
          "type": "element",
          "element": "fire",
          "value": 0.15
        }
      ]
    },
