  "ingameEffects": [
    {
      "id": "banyue-core-one_with_the_mountains",
      "source": "core",
      "sourceId": "banyue-core",
      "label": "One With the Mountains (Core Passive)",
      "description": "... When Banyue uses an EX Special Attack or Assist Follow-Up, he increases his Sheer Force by 300, Fire DMG by 36%, and CRIT DMG by 36% for 30s. Repeated triggers reset the duration.",
      "shortDescription": "Banyue's Sheer Force is increased by 300, Fire DMG is increased by 36% and CRIT DMG is increased by 36% for 36s.",
      "target": "self",
      "flat": {
        "sheerForce": 300,
        "critDmg": 0.36
      },
      "damageBonuses": [
        {
          "type": "element",
          "element": "fire",
          "value": 0.36
        }
      ]
    },
    {
      "id": "banyue-core-mountains_zenith",
      "source": "core",
      "sourceId": "banyue-core",
      "label": "Mountain's Zenith (Additional Ability)",
      "description": "When another character in your squad is a Support or Stun character:\n\nWhile in the Visage of Wrath state, when Banyue consumes Mountain's Might to unleash an EX Special Attack through a Basic Attack branch or quick input commands, he gains one stack of Vidyaraja. Each stack of Vidyaraja increases his Fire DMG by 5%, stacking up to 3 times and lasting 8s. Repeated triggers reset the duration.",
      "shortDescription": "Banyue's Fire DMG increases by 5% for 8s, stacking up to 3 times",
      "target": "self",
      "damageBonuses": [
        {
          "type": "element",
          "element": "fire",
          "value": 0.05
        }
      ],
      "maxStacks": 3
    },
    {
      "id": "banyue-mindscape_1_1-greed_burns_like_fire",
      "source": "mindscape",
      "sourceId": "banyue-mindscape_1",
      "label": "Greed Burns Like Fire (Mindscape Cinema N°1)",
      "description": "When Banyue hits an enemy with EX Special Attack: One's Path or EX Special Attack: Earth Shaker, he inflicts the Tremor state. In this state, enemies Fire RES is reduced by 10%, lasting 30s. When EX Special Attack: Lion's Roar, EX Special Attack: Lion's Roar - Wrath, EX Special Attack: Mountain Tremor, EX Special Attack: Mountain Tremor - Wrath, Basic Attack: Toppling Mountain, and Basic Attack: Crushing Peaks hits an enemy in the Tremor state, the Sheer DMG dealt is increased by 10%. When Basic Attack: Crushing Peaks hits a Stunned enemy, the current Stun duration is extended by 2s. This effect can only trigger once per Stun and does not stack with similar effects.",
      "shortDescription": "The target's Fire RES is reduced by 10% for 30s.",
      "target": "team",
      "flat": {
        "fireResShred": 0.1
      }
    },
    {
      "id": "banyue-mindscape_1_2-greed_burns_like_fire",
      "source": "mindscape",
      "sourceId": "banyue-mindscape_1",
      "label": "Greed Burns Like Fire (Mindscape Cinema N°1)",
      "description": "When Banyue hits an enemy with EX Special Attack: One's Path or EX Special Attack: Earth Shaker, he inflicts the Tremor state. In this state, enemies Fire RES is reduced by 10%, lasting 30s. When EX Special Attack: Lion's Roar, EX Special Attack: Lion's Roar - Wrath, EX Special Attack: Mountain Tremor, EX Special Attack: Mountain Tremor - Wrath, Basic Attack: Toppling Mountain, and Basic Attack: Crushing Peaks hits an enemy in the Tremor state, the Sheer DMG dealt is increased by 10%. When Basic Attack: Crushing Peaks hits a Stunned enemy, the current Stun duration is extended by 2s. This effect can only trigger once per Stun and does not stack with similar effects.",
      "shortDescription": "Banyue's Sheer DMG from EX Special Attack: Lion's Roar, EX Special Attack: Lion's Roar - Wrath, EX Special Attack: Mountain Tremor, EX Special Attack: Mountain Tremor - Wrath, Basic Attack: Toppling Mountain, and Basic Attack: Crushing Peaks is increased by 10%.",
      "target": "self",
      "damageBonuses": [
