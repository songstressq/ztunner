    {
      "id": "banyue-mindscape_6-descended_vidyaraja",
      "source": "mindscape",
      "sourceId": "banyue-mindscape_6",
      "label": "Descended Vidyaraja (Mindscape Cinema N°6)",
      "description": "At any time, when Banyue uses an EX Special Attack, he also gains Vidyaraja. The Fire DMG bonus from Vidyaraja is increased by an additional 8%, and its duration is extended to 30s. When activating Basic Attack: Crushing Peaks, Banyue deals Fire DMG equal to 600% of his Sheer Force to nearby enemies. Using Dodge: Battle Cry immediately after an EX Special Attack also grants Vidyaraja.",
      "shortDescription": "Banye's Fire DMG from Vidyaraja is increased by an additional 8%, stacking up to 3 times. Banyue's additional DMG is available in the Damage Calculator.",
