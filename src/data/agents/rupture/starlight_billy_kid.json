          ],
          "value": 0.5
        }
      ],
      "linkedEffects": ["starlight_billy_kid-mindscape_2_2-wasteland_automaton"]
    },
    {
      "id": "starlight_billy_kid-mindscape_2_2-wasteland_automaton",
      "source": "mindscape",
      "sourceId": "starlight_billy_kid-mindscape_2",
      "label": "Wasteland Automaton (Mindscape Cinema N°2)",
      "description": "Activating EX Special Attack: Rocking Footwork, EX Special Attack: High-Traction Wheels, or hitting a Stunned enemy with Special Attack: Drive Suppression grants the Turbocharged effect:\n\nSpecial Attack: Drive Suppression consumes this effect to immediately follow up with EX Special Attack: Cool Wheelie, and increases that instance's CRIT DMG by 50%. Only 1 stack of Turbocharged can be held.",
      "shortDescription": "Starlight - Billy Kid's CRIT DMG from EX Special Attack: Cool Wheelie is increased by 50%.",
      "target": "self",
      "exclusiveStatBonuses": [
        {
          "stat": "critDmg",
          "type": "exclusive",
          "appliesTo": ["starlight_billy_kid-ex_special_attack-cool_wheelie"],
          "value": 0.5
        }
      ]
    },
    {
      "id": "starlight_billy_kid-mindscape_4-flames_of_justice",
      "source": "mindscape",
      "sourceId": "starlight_billy_kid-mindscape_4",
      "label": "Flames of Justice (Mindscape Cinema N°4)",
      "description": "While in combat, each use of Special Attack: Drive Suppression increases Starlight - Billy's CRIT DMG by 8%, stacking up to 2 times, and lasting 45s. Repeated triggers reset the duration. If HP is below 35% and Starlight - Billy is not the active character, he continuously recovers HP, up to 35%.",
      "shortDescription": "Starlight - Billy Kid's CRIT DMG is increased by 8% for 45s, stacking up to 2 times.",
      "target": "self",
      "flat": {
        "critDmg": 0.08
      },
      "maxStacks": 2
    },
    {
      "id": "starlight_billy_kid-mindscape_6-starlight_knight",
      "source": "mindscape",
      "sourceId": "starlight_billy_kid-mindscape_6",
      "label": "Starlight Knight (Mindscape Cinema N°6)",
      "description": "Ultimate: Starlight Knight Flying Kick and Basic Attack: Full-Throttle Starlight's Sheer DMG increases by 18%. Landing the 4th hit of Basic Attack: Knight's Technique, EX Special Attack: Cool Wheelie, or Chain Attack: Knight's Swagger grants 1 stack of Brilliant Starlight, stacking up to 6 times, and gaining at most 1 stack per skill use. When using Ultimate: Starlight Knight Flying Kick or Basic Attack: Full-Throttle Starlight, consumes up to 2 stacks of Brilliant Starlight, with each stack consumed causing that skill's final hit to deal 100% Sheer Force as additional Physical DMG.",
      "shortDescription": "Starlight - Billy Kid's Sheer DMG from Ultimate: Starlight Knight Flying Kick and Basic Attack: Full-Throttle Starlight is increased by 18%. Brilliant Starlight's additional damage is available in the Damage Calculator.",
      "target": "self",
      "damageBonuses": [
