        }
      ]
    },
    {
      "id": "komano_manato-core_2-mighty_molten_edge",
      "source": "core",
      "sourceId": "komano_manato_core",
      "label": "Mighty Molten Edge (Core Passive)",
      "description": "... When consuming HP during Basic Attack: Blazing Wind - Misty Slash or during the consecutive slashes from an Assist Follow-Up, that attack's CRIT DMG increases by 50%, and the Adrenaline Generation Rate increases by 100%. ...",
      "shortDescription": "Manato's CRIT DMG from Basic Attack: Blazing Wind - Misty Slash and Assist Follow-Up: Lone Shadow - Breaking Fang consecutive slashes is increased by 50%.",
      "target": "self",
      "exclusiveStatBonuses": [
        {
          "stat": "critDmg",
          "type": "exclusive",
          "appliesTo": [
            "manato-basic_attack-blazing_wind-misty_slash",
            "manato-assist_follow_up-lone_shadow_breaking_fang"
          ],
          "value": 0.5
        }
      ]
    },
    {
      "id": "komano_manato-mindscape_1-drifters_rules_of_survival",
      "source": "mindscape",
      "sourceId": "komano_manato-mindscape_1",
      "label": "Drifter's Rules of Survival (Mindscape Cinema N°1)",
      "description": "Whenever Manato loses HP, the amount of HP lost is tallied. Each 1% of his Max HP tallied increases the Fire DMG of Assist Follow-Ups and Basic Attacks by 0.4%, up to a max of 20%.",
      "shortDescription": "Manato's Fire DMG from Basic Attacks and Assist Follow-Ups is increased by 0.4%, stacking up to 50 times.",
      "target": "self",
      "damageBonuses": [
        {
          "type": "elementExclusive",
          "element": "fire",
          "appliesTo": [
            "manato-basic_attack-blazing_wind_slash",
            "manato-basic_attack-blazing_wind-misty_slash",
            "manato-assist_follow_up-lone_shadow_breaking_fang"
          ],
          "value": 0.004
        }
      ],
      "maxStacks": 50
    },
    {
      "id": "komano_manato-mindscape_2-day_and_night_kitchen_and_love",
      "source": "mindscape",
      "sourceId": "komano_manato-mindscape_2",
      "label": "Day & Night, Kitchen & Love (Mindscape Cinema N°2)",
      "description": "While in the Molten Edge state, Manato ignores 8% of a target's Fire RES. After being hit by an enemy while using Special Attack: Return to Ashes or Special Attack: Return to Ashes - Sacrifice, press Basic Attack to trigger an Assist Follow-Up.",
      "shortDescription": "Manato's attacks ignore 8% of the target's Fire RES.",
      "target": "self",
      "flat": {
        "fireResShred": 0.08
      }
    },
    {
      "id": "komano_manato-mindscape_4-childhood_oath",
      "source": "mindscape",
      "sourceId": "komano_manato-mindscape_4",
      "label": "Childhood Oath (Mindscape Cinema N°4)",
      "description": "Max HP increases by 8%. During Special Attack: Return to Ashes and Special Attack: Return to Ashes - Sacrifice, when Manato takes fatal DMG, he remains in battle, with his HP not dropping below 1. This effect can trigger once every 10s.",
      "shortDescription": "Manato's HP is increased by 8%.",
      "target": "self",
      "flat": {
        "hpPercentRaw": 0.08
      }
    },
    {
      "id": "komano_manato-mindscape_6-beyond_dreams_of_the_past",
      "source": "mindscape",
      "sourceId": "komano_manato-mindscape_6",
      "label": "Beyond Dreams of the Past (Mindscape Cinema N°6)",
      "description": "When Special Attack: Return to Ashes hits a Stunned enemy, Manato gains 75 Blazing Heart and 4 stacks of Remnant Flame, and pressing [BASIC] will launch an Assist Follow-Up. This Remnant Flame effect can trigger once every 20s. When his Assist Follow-Up hits an enemy, Manato's Fire DMG increases by 3% for 8s, stacking up to 5 times. Repeated triggers reset the duration.",
      "shortDescription": "Manato's Fire DMG Bonus increases by 3% for 8s, stacking up to 5 times.",
      "target": "self",
      "damageBonuses": [
        {
          "type": "element",
          "element": "fire",
          "value": 0.03
        }
      ],
      "maxStacks": 5
    }
  ],
