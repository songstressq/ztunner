      "id": "komano_manato-core_1-mighty_molten_edge",
      "source": "core",
      "sourceId": "komano_manato_core",
      "label": "Mighty Molten Edge (Core Passive)",
      "description": "... While in the Molten Edge state, Manato's CRIT Rate increases by 10%, and his Fire DMG increases by 20%.",
