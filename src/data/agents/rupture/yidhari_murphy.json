  "ingameEffects": [
    {
      "id": "yidhari_murphy-chain_attack-ether_veil_wellspring",
      "source": "core",
      "sourceId": "yidhari_murphy-chain_attack",
      "label": "Ether Veil: Wellspring (Chain Attack)",
      "description": "When Decibel Rating is at Maximum, the final hit of Basic Attack: Frostbite Embrace, EX Special Attack: Frost Coil, EX Special Attack: Glacial Crush, and Chain Attack: Frostbound Oath will consume 3,000 Decibels to activate an Ether Veil: Wellspring. While Ether Veil: Wellspring is active, all squad members' Max HP increase by 5% for 30s. Repeated triggers extend the duration, up to a maximum of 300s. While Yidhari is within Ether Veil: Wellspring, the charge speed of Basic Attack: Frostbite Embrace increases, and HP is consumed faster during charging.",
      "shortDescription": "All squad members' Max HP is increased by 5% while Ether Veil: Wellspring is active.",
      "target": "team",
      "flat": {
        "hpPercentRaw": 0.05
      }
    },
    {
      "id": "yidhari_murphy-core-dreamscape_collection",
      "source": "core",
      "sourceId": "yidhari_murphy-core",
      "label": "Dreamscape Collection (Core Passive)",
      "description": "... Yidhari's skill DMG increases as her current HP percentage decreases. When her HP falls below 50%, the buff reaches its maximum value, increasing her DMG by up to 100%. Once her HP is restored to 50%, the maximum bonus remains for 5s thereafter. Yidhari gains fewer Decibels from landing skills. Instead, she gains Decibels as her HP decreases, with every 1% HP lost granting 10 Decibels.",
      "shortDescription": "Yidhari's DMG is increased by 100% when her HP is bellow 50%.",
      "target": "self",
      "damageBonuses": [
        {
          "type": "global",
          "value": 0.01
        }
      ],
      "maxStacks": 100
    },
    {
      "id": "yidhari_murphy-core-narrative_completion",
      "source": "core",
      "sourceId": "yidhari_murphy_core",
      "label": "Narrative Completion (Additional Ability)",
      "description": "When another character in your squad is a Stun or Support character:\n\nWhen Yidhari's HP falls below 50%, CRIT DMG increases by 30% and DMG taken is reduced by 25%. While Yidhari is within Ether Veil: Wellspring, she gains the following additional effect: After the level 3 charged attack of Yidhari's Basic Attack: Frostbite Embrace or EX Special Attack: Glacial Crush, an icy tentacle is summoned to attack, dealing extra damage. This effect can trigger once every 12s. The above skill is considered an EX Special Attack, the DMG multiplier increases based on the EX Special Attack's level.",
      "shortDescription": "Yidhari's CRIT DMG is increased by 30% when her HP is bellow 50%.",
      "target": "self",
      "flat": {
        "critDmg": 0.3
      }
    },
    {
      "id": "yidhari_murphy-mindscape_1-the_past_lost_beneath_the_abyss",
      "source": "mindscape",
      "sourceId": "yidhari_murphy-mindscape_1",
      "label": "The Past Lost Beneath the Abyss (Mindscape Cinema N°1)",
      "description": "The Adrenaline cost to activate Yidhari's EX Special Attack is reduced by 10. After using EX Special Attack: Frost Coil or EX Special Attack: Glacial Crush, keeping hold of the Basic Attack or Special Attack button consumes 35 Adrenaline to forgo healing and immediately chain into another EX Special Attack: Glacial Crush. The HP restored by this EX Special Attack: Glacial Crush is increased by 100% of the original value. Yidhari's Basic Attacks and EX Special Attacks ignore 20% of targets' Ice RES.",
      "shortDescription": "Yidhari's Basic Attacks an EX Special Attacks ignore 20% of the target's Ice RES.",
      "target": "self",
      "exclusiveStatBonuses": [
        {
          "stat": "iceResShred",
          "type": "exclusive",
          "appliesTo": [
            "yidhari-basic_attack-crushing_strike",
            "yidhari-basic_attack-frostbite_embrace",
            "yidhari-basic_attack-frosts_crushing_weight",
            "yidhari-ex_special_attack-frost_coil",
            "yidhari-ex_special_attack-glacial_crush"
          ],
          "value": 0.2
        }
      ]
    },
    {
      "id": "yidhari_murphy-mindscape_2-who_lingers_here_lost_in_thought",
      "source": "mindscape",
      "sourceId": "yidhari_murphy-mindscape_2",
      "label": "Who Lingers Here, Lost in Thought? (Mindscape Cinema N°2)",
      "description": "Yidhari's CRIT DMG increases by 40%. Triggering Surging Cold or Crushing Pursuit grants Adrenaline regen of 0.5/s for up to 30s. Repeated triggers reset the duration.",
      "shortDescription": "Yidhari's CRIT DMG is increased by 40%.",
      "target": "self",
      "flat": {
        "critDmg": 0.4
      }
    },
    {
      "id": "yidhari_murphy-mindscape_4-blooming_in_silence",
      "source": "mindscape",
      "sourceId": "yidhari_murphy-mindscape_4",
      "label": "Blooming in Silence (Mindscape Cinema N°4)",
      "description": "Yidhari gains 10% more Decibels when losing HP for Core Passive: Dreamscape Collection. While in Ether Veil: Wellspring, Yidhari's Max HP is further increased by 5%.",
      "shortDescription": "Yidhari's Max HP is further increased by 5% while Ether Veil: Wellspring is active.",
      "target": "self",
      "flat": {
        "hpPercentRaw": 0.05
      }
    },
    {
      "id": "yidhari_murphy-mindscape_6-at_last_a_peaceful_dream",
      "source": "mindscape",
      "sourceId": "yidhari_murphy-mindscape_6",
      "label": "At Last, a Peaceful Dream (Mindscape Cinema N°6)",
      "description": "After Yidhari spends Decibels to activate or extend Ether Veil: Wellspring, she gains Erudition for 30s. While Erudition is active, her Sheer DMG increases by 25%. Also, upon taking fatal DMG for the first time, her HP is reduced to at most 1, and for the next 5s, she cannot be defeated and will restore 25% HP over time.",
      "shortDescription": "Yidhari's Sheer DMG is increased by 25%.",
      "target": "self",
      "damageBonuses": [
        {
          "type": "sheerDmg",
          "value": 0.25
        }
      ]
    }
  ],
