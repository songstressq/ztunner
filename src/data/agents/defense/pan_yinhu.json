    },
    {
      "id": "pan_yinhu-core-iron_stomach",
      "source": "core",
      "sourceId": "pan_yinhu-core",
      "label": "Iron Stomach (Additional Ability)",
      "description": "When another character in your squad is a Rupture character or shares the same Faction:\n\nWhen Pan Yinhu hits an enemy with Special Attack: Touch of Death, the enemy suffers the Depleted Qi effect, increasing all DMG against the target by 20%. Each hit of Special Attack: Touch of Death inflicts a 10s Depleted Qi effect. This effect can't stack, but repeated hits on the same enemy will extend the duration.",
      "shortDescription": "All squad members' DMG is increased by 20% for 10s.",
      "target": "team",
      "damageBonuses": [
        {
          "type": "global",
          "value": 0.2
        }
      ]
    },
    {
      "id": "pan_yinhu-mindscape_1-qi_shield",
      "source": "mindscape",
      "sourceId": "pan_yinhu-mindscape_1",
      "label": "Qi Shield (Mindscape Cinema N°1)",
      "description": "All units deal 10% increased DMG to enemies affected by Depleted Qi.",
      "shortDescription": "All squad members' DMG is further increased by 10% for 10s.",
      "target": "team",
      "damageBonuses": [
        {
          "type": "global",
          "value": 0.1
        }
      ]
    },
    {
      "id": "pan_yinhu-mindscape_2-yunkui_pressure_point_strike",
      "source": "mindscape",
      "sourceId": "pan_yinhu-mindscape_2",
      "label": "Yunkui Pressure-Point Strike (Mindscape Cinema N°2)",
      "description": "For every 6 points of Break Force consumed, Pan Yinhu will recover 4 Energy, and the Depleted Qi effect applied when Special Attack: Touch of Death hits an enemy will have its duration increased to 12s.",
      "shortDescription": "This mindscape cinema does not affect Pan Yinhu's stats.",
      "infoOnly": true
    },
    {
      "id": "pan_yinhu-mindscape_4-first_class_head_chef",
      "source": "mindscape",
      "sourceId": "pan_yinhu-mindscape_4",
      "label": "First-Class Head Chef (Mindscape Cinema N°4)",
      "description": "When Ultimate: A Feast Fit for an Emperor! heals all squad members, the HP recovery is increased by 25%, and the healing over time effect is increased by 25%. On activating Ultimate: A Feast Fit for an Emperor!, gain the Backup Provisions effect. Whenever any character in the squad loses HP, consume the Backup Provisions effect to instantly restore 50% of the HP recovered with Ultimate: A Feast Fit for an Emperor!'s instant HP recovery effect. This effect cannot stack.",
      "shortDescription": "This mindscape cinema does not affect Pan Yinhu's stats.",
      "infoOnly": true
    },
    {
      "id": "pan_yinhu-mindscape_6-meridian_theory",
      "source": "mindscape",
      "sourceId": "pan_yinhu-mindscape_6",
      "label": "Meridian Theory (Mindscape Cinema N°6)",
      "description": "The Meridian Flow effect provided by Core Passive: Meridian Enlightenment gains an additional Sheer Force bonus equal to 6% of Pan Yinhu's initial ATK. The maximum Sheer Force provided by this effect increases to 720.",
