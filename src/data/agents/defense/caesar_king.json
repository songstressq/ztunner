    {
      "id": "caesar_king-core-barrier_of_resilience",
      "source": "core",
      "sourceId": "caesar_king-core",
      "label": "Barrier of Resilience (Core Passive)",
      "description": "When Caesar activates EX Special Attack: Parry Counter, Chain Attack, Ultimate, or triggers EX Special Attack: Overpowered Shield Bash through Retaliation, she buffs the entire team with a Radiant Aegis shield equal to 1400% of her base Impact + 1400. The shield lasts for 90s and is equipped by the on-field character, with its value shared among the entire team. While Radiant Aegis is active, the shield bearer's Anti-Interrupt level is increased, and their ATK is increased by 1000. After Radiant Aegis expires, the buff remains for an additional 5s.",
      "shortDescription": "All squad members's ATK is increased by 1000.",
      "target": "team",
      "flat": {
        "atkFlatRaw": 1000
      }
    },
    {
      "id": "caesar_king-core-battle_spirit",
      "source": "core",
      "sourceId": "caesar_king-core",
      "label": "Battle Spirit (Additional Ability)",
      "description": "When there is another character in your squad who can activate Defensive Assist or is from the same Faction:\n\nWhen Caesar activates Perfect Block, Retaliation, Defensive Assist, or Basic Attack: Dead End, she applies a Debuff effect to enemies within a 7m radius, increasing the damage they take from all teammates by 25% for 30s.",
      "shortDescription": "All squad members' DMG is increased by 25% for 30s.",
      "target": "team",
      "damageBonuses": [
        {
          "type": "global",
          "value": 0.25
        }
      ]
    },
    {
      "id": "caesar_king-mindscape_1-spearhead_advance",
      "source": "mindscape",
      "sourceId": "caesar_king-mindscape_1",
      "label": "Spearhead Advance (Mindscape Cinema N°1)",
      "description": "When Caesar enters combat or switches in, she instantly buffs the entire team with a Radiant Aegis shield, which can be can be triggered once every 300s. While Radiant Aegis is active, enemies within a 5m radius of the shield bearer suffer a 15% Attribute DMG RES reduction.",
      "shortDescription": "The target's All-Attribute RES is reduced by 15%.",
      "target": "team",
      "perStack": {
        "fireResShred": 0.15,
        "iceResShred": 0.15,
        "electricResShred": 0.15,
        "physicalResShred": 0.15,
        "etherResShred": 0.15,
        "windResShred": 0.15
      }
    },
    {
      "id": "caesar_king-mindscape_2-legacy_of_the_far_lands",
      "source": "mindscape",
      "sourceId": "caesar_king-mindscape_2",
      "label": "Legacy of the Far Lands (Mindscape Cinema N°2)",
      "description": "While Radiant Aegis is active during Core Passive: Barrier of Resilience, Caesar's Energy Generation increases by 10%, and the shield bearer's attack boost is increased to 150% of its original value.",
      "shortDescription": "Caesar's Energy Regen is increased by 10%.",
      "target": "self",
      "flat": {
        "energyRegenPercentRaw": 0.1
      }
    },
    {
      "id": "caesar_king-mindscape_4-aries_the_battering_ram",
      "source": "mindscape",
      "sourceId": "caesar_king-mindscape_4",
      "label": "Aries the Battering-Ram (Mindscape Cinema N°4)",
      "description": "When Caesar uses a Chain Attack or Ultimate, she gains 3 additional Assist Points. If her Energy is below 20, she can activate EX Special Attack: Overpowered Shield Bash with 1 Assist Point instead. This substitution can only be triggered once every 5s.",
      "shortDescription": "This mindscape cinema does not affect Caesar's stats.",
      "infoOnly": true
    },
    {
      "id": "caesar_king-mindscape_6_1-overlords_will",
      "source": "mindscape",
      "sourceId": "caesar_king-mindscape_6",
      "label": "Overlord's Will (Mindscape Cinema N°6)",
      "description": "EX Special Attack: Overpowered Shield Bash and Assist Follow-Up: Aiding Blade are guaranteed to trigger a critical hit. The skill's DMG is increased by 50% and deals additional 50% DMG to the primary target. When Caesar uses EX Special Attack: Overpowered Shield Bash or Assist Follow-Up: Aiding Blade, her CRIT Rate is increased by 30% and her CRIT DMG is increased by 60% for 15s.",
      "shortDescription": "Caesar's CRIT rate is increased by 30% and her CRIT DMG is increased by 60%.",
      "target": "self",
      "flat": {
        "critRate": 0.3,
        "critDmg": 0.6
      }
    },
    {
      "id": "caesar_king-mindscape_6_2-overlords_will",
      "source": "mindscape",
      "sourceId": "caesar_king-mindscape_6",
      "label": "Overlord's Will (Mindscape Cinema N°6)",
      "description": "EX Special Attack: Overpowered Shield Bash and Assist Follow-Up: Aiding Blade are guaranteed to trigger a critical hit. The skill's DMG is increased by 50% and deals additional 50% DMG to the primary target. When Caesar uses EX Special Attack: Overpowered Shield Bash or Assist Follow-Up: Aiding Blade, her CRIT Rate is increased by 30% and her CRIT DMG is increased by 60% for 15s.",
      "shortDescription": "Caesar's DMG from EX Special Attack: Overpowered Shield Bash and Assist Follow-Up: Aiding Blade is increased by 50%, with an additional 50% to the primary target.",
