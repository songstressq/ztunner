  "ingameEffects": [
    {
      "id": "seth_lowell-core-protector",
      "source": "core",
      "sourceId": "seth_lowell-core",
      "label": "Protector (Core Passive)",
      "description": "When Seth uses EX Special Attack: Thunder Shield Rush - High Voltage, he gains a Shield of Firm Resolve equal to 80% of his initial ATK, up to a max of 3,000 points, and lasting 25s. This effect can trigger once every 10s. When Basic Attack: Lightning Strike - Electrified or Assist Follow-Up: Public Security Ruling triggers a Quick Assist or Chain Attack, causing another squad member to enter the field, that squad member gains a Shield of Firm Resolve equal to 80% of Seth's initial ATK, up to a max of 3,000 points, and lasting 25s. This effect can trigger once every 10s. Having a Shield of Firm Resolve increases Anomaly Proficiency by 100.",
      "shortDescription": "The on-field agent's Anomaly Proficiency is increased by 100.",
      "target": "self",
      "requiresManualTarget": true,
      "flat": {
        "anomalyProficiency": 100
      },
      "condition": {
        "applyToSelectedOnly": true
      }
    },
    {
      "id": "seth_lowell-mindscape_1-heroism",
      "source": "mindscape",
      "sourceId": "seth_lowell-mindscape_1",
      "label": "Heroism (Mindscape Cinema N°1)",
      "description": "The shield value provided by Shield of Firm Resolve and its maximum limit is increased by 30%. When Shield of Firm Resolve ends, the Anomaly Proficiency increase provided by Core Passive: Protector lasts an additional 10s.",
      "shortDescription": "This mindscape cinema does not affect Seth's stats.",
      "infoOnly": true
    },
    {
      "id": "seth_lowell-mindscape_2-recklessness_of_youth",
      "source": "mindscape",
      "sourceId": "seth_lowell-mindscape_2",
      "label": "Recklessness of Youth (Mindscape Cinema N°2)",
      "description": "Upon entering battle, Seth immediately gains 75% Resolve. Hitting an enemy with Basic Attack: Lightning Strike - Electrified increases the move's accumulated Electric Anomaly Buildup by 35%.",
      "shortDescription": "This mindscape cinema does not affect Seth's stats.",
      "infoOnly": true
    },
    {
      "id": "seth_lowell-mindscape_4-core_aspiration",
      "source": "mindscape",
      "sourceId": "seth_lowell-mindscape_4",
      "label": "Core Aspiration (Mindscape Cinema N°4)",
      "description": "The Daze caused by Defensive Assist: Thundershield is increased by 25%.",
      "shortDescription": "This mindscape cinema does not affect Seth's stats.",
      "infoOnly": true
    },
    {
      "id": "seth_lowell-mindscape_6-idealist",
      "source": "mindscape",
      "sourceId": "seth_lowell-mindscape_6",
      "label": "Idealist (Mindscape Cinema N°6)",
      "description": "When Seth lands a finishing strike on an enemy with Basic Attack: Lightning Strike - Electrified, it deals additional damage equal to 500% of his ATK. The attack is guaranteed to trigger a CRIT, and CRIT DMG is increased by 60%.",
      "shortDescription": "Seth's CRIT DMG from Basic Attack: Lightning Strike - Electrified is increased by 60%. It's additional damage is available in the Damage Calculator.",
      "target": "self",
