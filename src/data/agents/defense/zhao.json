    {
      "id": "zhao-core_1-ideal_colleague",
      "source": "core",
      "sourceId": "zhao-core",
      "label": "Ideal Colleague (Core Passive)",
      "description": "Zhao gains bonus CRIT Rate based on her initial Max HP, gaining 1.4% CRIT Rate for every 1,000 initial Max HP.",
      "shortDescription": "Zhao's CRIT Rate is increased based on her initial HP.",
      "target": "self",
