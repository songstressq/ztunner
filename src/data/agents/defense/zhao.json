          {
            "level": 1,
            "maxBonus": 99999,
            "perUnitBonus": 0.014
          }
        ],
        "affectedStats": ["critRate"]
      }
    },
    {
      "id": "zhao-core_2-ideal_colleague",
      "source": "core",
      "sourceId": "zhao-core",
      "label": "Ideal Colleague (Core Passive)",
      "description": "When Zhao activates her Entry Skill, all Frostbite Points are consumed to activate Ether Veil: Wellspring. While Ether Veil: Wellspring is active, all squad members gain 5% Max HP for 40s. Re-activating Ether Veil: Wellspring ends the existing instance before applying a new Ether Veil: Wellspring.",
      "shortDescription": "All squad members' Max HP is increased by 5% while Ether Veil: Wellspring is active.",
      "target": "team",
      "flat": {
        "hpPercentRaw": 0.05
      }
    },
    {
      "id": "zhao-core_3-ideal_colleague",
      "source": "core",
      "sourceId": "zhao-core",
      "label": "Ideal Colleague (Core Passive)",
      "description": "When Zhao activates Ether Veil: Wellspring, all squad members' ATK increase by 1000 for 50s. Repeated triggers reset the duration.",
      "shortDescription": "All squad members' ATK is increased by 1000 for 50s.",
      "target": "team",
      "flat": {
        "atkFlatRaw": 1000
      }
    },
    {
      "id": "zhao-core-crystallization",
      "source": "core",
      "sourceId": "zhao-core",
      "label": "Crystallization (Additional Ability)",
      "description": "When another character in your squad is an Attack, Anomaly, or Support character: When Zhao is within any Ether Veil, the whole squad's DMG increases by 10%. If Zhao's initial Max HP exceeds 15,000, every additional 400 initial Max HP increases this DMG bonus by an additional 1%, up to a total maximum increase of 40%. This bonus reaches its maximum when Zhao's initial Max HP reaches 27,000.",
      "shortDescription": "All squad members' DMG is increased based on Zhao's initial HP.",
      "target": "team",
      "conditional": {
        "type": "initialStatBasedDamageBonus",
        "basedOn": "hp",
        "threshold": 15000,
        "baseBonus": 0.1,
        "perUnit": 400,
        "skillLevels": [
          {
            "level": 1,
            "perUnitBonus": 0.01,
            "maxBonus": 0.4
          }
        ],
        "damageBonusType": "global"
      }
    },
    {
      "id": "zhao-mindscape_1-righteous_verdict",
      "source": "mindscape",
      "sourceId": "zhao-mindscape_1",
      "label": "Righteous Verdict (Mindscape Cinema N°1)",
      "description": "When Zhao switches out of being the active character, all squad members' DMG ignores 15% of the target's All-Attribute RES for 50s.",
      "shortDescription": "The target's All-Attribute RES is reduced by 15% for 50s.",
      "target": "team",
      "perStack": {
