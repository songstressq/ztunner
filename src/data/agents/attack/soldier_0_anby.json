    {
      "id": "soldier_0_anby-mindscape_1-static_charge",
      "source": "mindscape",
      "sourceId": "soldier_0_anby-mindscape_1",
      "label": "Static Charge (Mindscape Cinema N°1)",
      "description": "When Soldier 0 - Anby uses an EX Special Attack to hit an enemy, it triggers the additional DMG from White Thunder 3 times. This effect does not consume any White Thunder stacks.",
      "shortDescription": "This mindscape cinema does not affect Soldier 0 - Anby's stats.",
      "infoOnly": true
    },
    {
      "id": "soldier_0_anby-mindscape_2-fail_safe_protocol",
      "source": "mindscape",
      "sourceId": "soldier_0_anby-mindscape_2",
      "label": "Fail-Safe Protocol (Mindscape Cinema N°2)",
      "description": "Soldier 0 - Anby's CRIT Rate increases by 12%. When she uses her Ultimate, she gains 6 stacks of Thunder's Cry (max 6 stacks). With Thunder's Cry, when using Special Attack: Azure Flash to hit an enemy with White Thunder, it will consume 1 stack of Thunder's Cry instead. Only 1 stack of Thunder's Cry will be consumed when a single use of a skill hits multiple enemies, and consuming Thunder's Cry will still activate the additional DMG from White Thunder.",
      "shortDescription": "Soldier 0 - Anby's CRIT Rate is increased by 12%.",
      "target": "self",
      "flat": {
        "critRate": 0.12
      }
    },
    {
      "id": "soldier_0_anby-mindscape_4-silver_reverb",
      "source": "mindscape",
      "sourceId": "soldier_0_anby-mindscape_4",
      "label": "Silver Reverb (Mindscape Cinema N°4)",
      "description": "When hitting an enemy marked with Silver Star, Soldier 0 - Anby ignores 12% of the target's Electric RES.",
      "shortDescription": "Soldier 0 - Anby ignores 12% of the target's Electric RES.",
      "target": "self",
      "flat": {
        "electricResShred": 0.12
      }
    },
    {
      "id": "soldier_0_anby-mindscape_6-prequel_protagonist",
      "source": "mindscape",
      "sourceId": "soldier_0_anby-mindscape_6",
      "label": "Prequel Protagonist (Mindscape Cinema N°6)",
      "description": "Upon triggering 6 instances of White Thunder's additional DMG, an electromagnetic vortex will be generated, dealing 1,000% of Soldier 0 - Anby's ATK as Electric DMG against the target and surrounding enemies. This DMG is considered Aftershock DMG.",
      "shortDescription": "This ability is available in the Damage Calculator.",
      "infoOnly": true
    }
