  "ingameEffects": [
    {
      "id": "hugo_vlad-core_1-terminating_verdict",
      "source": "core",
      "sourceId": "hugo_vlad-core",
      "label": "Terminating Verdict (Core Passive)",
      "description": "When Chain Attack: Trick of Fate hits an enemy or Hugo's attacks Stun an enemy, Hugo gains the Dark Abyss Reverb state for 6s, and repeated triggers reset the duration. During this state, Hugo's CRIT Rate increases by 12% and CRIT DMG increases by 25%. When there is 1 Stun character in your squad, Hugo's ATK increases by 300.",
      "shortDescription": "Hugo's CRIT Rate increases by 12% and CRIT DMG increases by 25%. Hugo's ATK increases by 300 with a stun agent in the squad.",
      "target": "self",
      "flat": {
        "critRate": 0.12,
        "critDmg": 0.25,
        "atkFlatRaw": 300
      }
    },
    {
      "id": "hugo_vlad-core_2-terminating_verdict",
      "source": "core",
      "sourceId": "hugo_vlad_core",
      "label": "Terminating Verdict (Core Passive)",
      "description": "When Chain Attack: Trick of Fate hits an enemy or Hugo's attacks Stun an enemy, Hugo gains the Dark Abyss Reverb state for 6s, and repeated triggers reset the duration. During this state, Hugo's CRIT Rate increases by 12% and CRIT DMG increases by 25%. When there are 2 Stun characters in your squad, Hugo's ATK increases by 900.",
      "shortDescription": "Hugo's CRIT Rate increases by 12% and CRIT DMG increases by 25%. Hugo's ATK increases by 900 with two stun agents in the squad.",
      "target": "self",
      "flat": {
        "critRate": 0.12,
        "critDmg": 0.25,
        "atkFlatRaw": 900
      }
    },
    {
      "id": "hugo_vlad-core_3-prelude_to_finality",
      "source": "core",
      "sourceId": "hugo_vlad-core",
      "label": "Prelude to Finality (Additional Ability)",
      "description": "When another character in your squad is a Stun character or shares the same attribute: Chain Attack: Trick of Fate's DMG increases by 15%, with a further increase of 35% against normal enemies. When Totalize is triggered, the DMG dealt by the skill increases by 40%. EX Special Attack: Soul Hunter - Punishment generates an additional 20 Energy when triggering Totalize on normal enemies. The Energy generation effect can trigger once every 30s.",
      "shortDescription": "Hugo's DMG from Chain Attack: Trick of Fate is increased by 15%.",
      "target": "self",
      "damageBonuses": [
        {
          "type": "exclusive",
          "appliesTo": ["hugo-chain_attack-trick_of_fate"],
          "value": 0.15
        }
      ]
    },
    {
      "id": "hugo_vlad-core_4-prelude_to_finality",
      "source": "core",
      "sourceId": "hugo_vlad-core",
      "label": "Prelude to Finality (Additional Ability)",
      "description": "When another character in your squad is a Stun character or shares the same attribute: Chain Attack: Trick of Fate's DMG increases by 15%, with a further increase of 35% against normal enemies. When Totalize is triggered, the DMG dealt by the skill increases by 40%. EX Special Attack: Soul Hunter - Punishment generates an additional 20 Energy when triggering Totalize on normal enemies. The Energy generation effect can trigger once every 30s.",
      "shortDescription": "Hugo's DMG from Chain Attack: Trick of Fate is further increased by 15% against normal enemies.",
      "target": "self",
      "damageBonuses": [
        {
          "type": "exclusive",
          "appliesTo": ["hugo-chain_attack-trick_of_fate"],
          "value": 0.35
        }
      ]
    },
    {
      "id": "hugo_vlad-core_5-prelude_to_finality",
      "source": "core",
      "sourceId": "hugo_vlad-core",
      "label": "Prelude to Finality (Additional Ability)",
      "description": "When another character in your squad is a Stun character or shares the same attribute:\n\nChain Attack: Trick of Fate's DMG increases by 15%, with a further increase of 35% against normal enemies. When Totalize is triggered, the DMG dealt by the skill increases by 40%. EX Special Attack: Soul Hunter - Punishment generates an additional 20 Energy when triggering Totalize on normal enemies. The Energy generation effect can trigger once every 30s.",
      "shortDescription": "Hugo's DMG from Totalize is increased by 40%.",
      "target": "self",
      "damageBonuses": [
        {
          "type": "hitExclusive",
          "skillId": "hugo-ex_special_attack-soul_hunter_punishment",
          "hitName": "Totalize Finishing Move",
          "value": 0.4
        },
        {
          "type": "hitExclusive",
          "skillId": "hugo-ultimate-blaspheme",
          "hitName": "Totalize Finishing Move",
          "value": 0.4
        }
      ]
    },
    {
      "id": "hugo_vlad-mindscape_1-child_of_hatred",
      "source": "mindscape",
      "sourceId": "hugo_vlad-mindscape_1",
      "label": "Child of Hatred (Mindscape Cinema N°1)",
      "description": "When triggering the Totalize effect in the Dark Abyss Reverb state, the skill's CRIT Rate is increased by an additional 12%, and CRIT DMG by 30%.",
      "shortDescription": "Hugo's Totalize CRIT DMG is increased by 30%.",
      "target": "self",
      "damageBonuses": [
        {
          "type": "hitStatExclusive",
          "stat": "critDmg",
          "value": 0.3,
          "appliesTo": [
            "hugo-ex_special_attack-soul_hunter_punishment",
            "hugo-ultimate-blaspheme"
          ],
          "hitName": "Totalize Finishing Move"
        }
      ]
    },
    {
      "id": "hugo_vlad-mindscape_2-child_of_hatred",
      "source": "mindscape",
      "sourceId": "hugo_vlad-mindscape_2",
      "label": "Child of Hatred (Mindscape Cinema N°2)",
      "description": "When Ultimate: Blaspheme triggers Totalize, it will not end the enemy's Stunned state. Additionally, when Totalize is triggered, the skill will ignore 15% of the enemy's DEF.",
      "shortDescription": "Hugo's Totalize DMG ignores 15% of the target's DEF.",
      "target": "self",
      "damageBonuses": [
        {
          "type": "hitStatExclusive",
          "stat": "defShred",
          "value": 0.15,
          "appliesTo": [
