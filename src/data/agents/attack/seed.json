  "ingameEffects": [
    {
      "id": "seed_core_flower_chain_protocol",
      "source": "core",
      "sourceId": "seed_core_1",
      "label": "Flower Chain Protocol (Core Passive)",
      "description": "The Attack teammate with the highest initial ATK is considered Seed's Vanguard. When the Vanguard unleashes an EX Special Attack, Seed gains Onslaught status, increasing Seed's ATK by 1000 and CRIT DMG by 30%. When Seed unleashes an EX Special Attack, the Vanguard gains Direct Strike status, increasing the Vanguard's ATK by 1000 and CRIT DMG by 30%. When Direct Strike and Onslaught are both active, Seed and the Vanguard simultaneously gain Besiege status, increasing DMG dealt by 25%.",
      "shortDescription": "Seed's and her Vanguard's ATK is increased by 1000 and CRIT DMG is increased by 30%.",
      "target": "self",
      "requiresManualVanguard": true,
      "infoOnly": true
    },
    {
      "id": "seed-core-surprise_strike",
      "source": "core",
      "sourceId": "seed-core",
      "label": "Surprise Strike (Additional Ability)",
      "description": "When another Attack Character is in your squad: When Seed deals DMG as the active character, restore 2 Energy to the Vanguard. This effect can trigger once every 1s. Seed's Basic Attack: Falling Petals - Slaughter, Basic Attack: Falling Petals - Downfall, and Ultimate: Clockwork Garden - Bloom! deal 30% increased DMG and ignore 25% of enemy Electric RES.",
      "shortDescription": "Seed's DMG from Basic Attack: Falling Petals - Slaughter, Basic Attack: Falling Petals - Downfall and Ultimate: Clockwork Garden - Bloom! is increased by 30% and ignores 25% of the target's Electric RES.",
      "target": "self",
      "damageBonuses": [
        {
          "type": "exclusive",
          "appliesTo": [
            "seed-basic_attack-falling_petals_slaughter",
            "seed-basic_attack-falling_petals_downfall",
            "seed-ultimate-clockwork_garden_bloom"
          ],
          "value": 0.3
        }
      ],
      "exclusiveStatBonuses": [
        {
          "stat": "electricResShred",
          "type": "exclusive",
          "appliesTo": [
            "seed-basic_attack-falling_petals_slaughter",
            "seed-basic_attack-falling_petals_downfall",
            "seed-ultimate-clockwork_garden_bloom"
          ],
          "value": 0.25
        }
      ]
    },
    {
      "id": "seed-mindscape_1-hibernation_period",
      "source": "mindscape",
      "sourceId": "seed-mindscape_1",
      "label": "Hibernation Period (Mindscape Cinema N°1)",
      "description": "When Seed's Steel Charge reaches 100, Basic Attack: Falling Petals - Downfall can be triggered, and the total Steel Charge consumed is reduced to 100. The amount of Steel Charge required to gain one chance to quickly release Basic Attack: Falling Petals - Slaughter is reduced to 100. Accumulate an additional 40/20 Steel Charge when entering the battlefield/using Ultimate. Increases Basic Attack: Falling Petals - Downfall CRIT DMG by 30%.",
      "shortDescription": "Seed's CRIT DMG from Basic Attack: Falling Petals - Downfall is increased by 30%.",
      "target": "self",
      "exclusiveStatBonuses": [
        {
          "stat": "critDmg",
          "type": "exclusive",
          "appliesTo": ["seed-basic_attack-falling_petals_downfall"],
          "value": 0.3
        }
      ]
    },
    {
      "id": "seed-mindscape_2-light_absorption_technique_1",
      "source": "mindscape",
      "sourceId": "seed-mindscape_2",
      "label": "Light Absorption Technique (Mindscape Cinema N°2)",
      "description": "When Besiege is active for an Agent, that Agent's DMG ignores 20% of DEF. When activating EX Special Attack: Raining Iron Petals, after consuming a total of 60 Energy, Seed can continue consuming Energy to extend the duration of the skill until the button is released or a total of 120 Energy is consumed. For every 5 Energy consumed by EX Special Attack: Raining Iron Petals, the following Basic Attack: Falling Petals - Slaughter's DMG increases by 5%.",
      "shortDescription": "Seed's and her Vanguard's DMG ignores 20% of the target's DEF.",
      "target": "self",
      "requiresManualTarget": true,
      "flat": {
        "defShred": 0.2
      },
      "linkedEffects": ["seed-mindscape_2-light_absorption_technique_2"]
    },

    {
      "id": "seed-mindscape_2-light_absorption_technique_2",
      "source": "mindscape",
      "sourceId": "seed-mindscape_2",
      "label": "Light Absorption Technique (Mindscape Cinema N°2)",
      "description": "When Besiege is active for an Agent, that Agent's DMG ignores 20% of DEF. When activating EX Special Attack: Raining Iron Petals, after consuming a total of 60 Energy, Seed can continue consuming Energy to extend the duration of the skill until the button is released or a total of 120 Energy is consumed. For every 5 Energy consumed by EX Special Attack: Raining Iron Petals, the following Basic Attack: Falling Petals - Slaughter's DMG increases by 5%.",
      "shortDescription": "Seed's DMG from Basic Attack: Falling Petals - Slaughter is increased by 30%, stacking up to 24 times.",
      "target": "self",
      "damageBonuses": [
        {
          "type": "exclusive",
          "appliesTo": ["seed-basic_attack-falling_petals_slaughter"],
          "value": 0.05
        }
      ],
      "maxStacks": 24
    },

    {
      "id": "seed-mindscape_4-fragrant_tune",
      "source": "mindscape",
      "sourceId": "seed-mindscape_4",
      "label": "Fragrant Tune (Mindscape Cinema N°4)",
      "description": "When Seed's Besiege status buff is active, her Decibel Generation Rate increases by 10%, and Ultimate DMG increases by 20%.",
      "shortDescription": "Seed's DMG from Ultimates is increased by 20%.",
