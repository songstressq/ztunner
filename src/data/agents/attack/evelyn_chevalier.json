  "ingameEffects": [
    {
      "id": "evelyn_chevalier-core-entangle",
      "source": "core",
      "sourceId": "evelyn_chevalier-core",
      "label": "Entangle (Core Passive)",
      "description": "Upon entering Binding Seal, Evelyn's CRIT Rate increases by 25%. After leaving Binding Seal, she retains the buff for 10s. If Evelyn switches to another character while in Binding Seal, she will automatically follow up with Special Attack: Binding Sunder - First Form.",
      "shortDescription": "Evelyn's CRIT Rate is increased by 25% for 10s.",
      "target": "self",
      "flat": {
        "critRate": 0.25
      }
    },
    {
      "id": "evelyn_chevalier-core-ambush_point",
      "source": "core",
      "sourceId": "evelyn_chevalier-core",
      "label": "Ambush Point (Aditional Ability)",
      "description": "When another character in your squad is a Stun or Support character:\n\nEvelyn's Chain Attack and Ultimate DMG increases by 30%. When Evelyn's CRIT Rate is at or over 80%, the DMG multiplier for her Chain Attack: Lunalux - Snare, Ultimate: Lunalux Garrote - Timbre and Ultimate: Lunalux Garrote - Shadow increases to 125% of the original value.",
      "shortDescription": "Evelyn's DMG from Chain Attacks and Ultimates is increased by 30%. Evelyn's increased multipliers are available in the Damage Calculator.",
      "target": "self",
      "damageBonuses": [
        {
          "type": "skillType",
          "skillType": "ultimate",
          "value": 0.3
        },
        {
          "type": "skillType",
          "skillType": "chain",
          "value": 0.3
        }
      ]
    },
    {
      "id": "evelyn_chevalier-mindscape_1-dreamweave",
      "source": "mindscape",
      "sourceId": "evelyn_chevalier-mindscape_1",
      "label": "Dreamweave (Mindscape Cinema N°1)",
      "description": "Upon entering the battlefield, Evelyn immediately gains 1,500 Decibels. Enemies affected by Binding Seal will be Bound. When Evelyn attacks Bound enemies, she ignores 12% of their DEF. When Evelyn uses Special Attack: Binding Sunder - First Form or EX Special Attack: Binding Sunder - Final Form, the Bound effect spreads to all enemies hit by the skill. This spread Bound effect lasts for 10s.",
      "shortDescription": "Evelyn's attacks ignore 12% of the target's DEF.",
      "target": "self",
      "flat": {
        "defShred": 0.12
      }
    },
    {
      "id": "evelyn_chevalier-mindscape_2-dance_of_fire",
      "source": "mindscape",
      "sourceId": "evelyn_chevalier-mindscape_2",
      "label": "Dance of Fire (Mindscape Cinema N°2)",
      "description": "Evelyn's ATK increases by 15%. When Evelyn uses Basic Attack: Garrote - First Form or Basic Attack: Garrote - Second Form, the Burning Embers consumed will be returned. This effect can trigger once every 25s. When Evelyn consumes Burning Tether Point to trigger Chain Attack: Lunalux - Snare, the skill's Interrupt Level increases.",
      "shortDescription": "Evelyn's ATK is increased by 15%.",
      "target": "self",
      "flat": {
        "atkPercentRaw": 0.15
      }
    },
    {
      "id": "eevelyn_chevalier-mindscape_4-fates_melody",
      "source": "mindscape",
      "sourceId": "evelyn_chevalier-mindscape_4",
      "label": "Fate's Melody (Mindscape Cinema N°4)",
      "description": "Upon activating a Chain Attack or Ultimate, Evelyn immediately gains a shield equal to 10% of her Max HP. While this shield exists, Evelyn's CRIT DMG increases by 40%.",
      "shortDescription": "Evelyn's CRIT DMG is increased by 40% while shielded.",
      "target": "self",
      "flat": {
        "critDmg": 0.4
      }
    },
    {
      "id": "evelyn_chevalier-mindscape_6-bond_of_light_and_shadow",
      "source": "mindscape",
      "sourceId": "evelyn_chevalier-mindscape_6",
      "label": "Bond of Light and Shadow (Mindscape Cinema N°6)",
      "description": "When activating her Chain Attack or Ultimate, Evelyn gains Shadowstring Edge for 20s. During Shadowstring Edge, when Evelyn hits enemies with a Basic Attack, Dash Attack, Special Attack, or EX Special Attack, an additional Lunalux Garrote will be released for a follow-up attack, dealing Fire DMG equal to 375% of Evelyn's ATK. This DMG is considered Chain Attack DMG and can trigger up to 16 times. The number of triggers will be refreshed each time Shadowstring Edge is gained.",
      "shortDescription": "This ability is available in the Damage Calculator.",
      "infoOnly": true
    }
  ],
