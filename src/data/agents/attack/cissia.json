      "flat": {
        "critDmg": 0.05
      }
    },
    {
      "id": "cissia-basic_attack-corrode_bone",
      "source": "core",
      "sourceId": "cissia-basic_attack",
      "label": "Corrode Bone (Basic Attack)",
      "description": "... Each trigger increases CRIT Rate by 6% for 15s, stacking up to 3 times. Repeated triggers refresh the duration.",
      "shortDescription": "Cissia's CRIT Rate is increased by 6% for 15s, stacking up to 3 times.",
      "target": "self",
      "maxStacks": 3,
      "flat": {
        "critRate": 0.06
      }
    },
    {
      "id": "cissia-core-fatal_concoction",
      "source": "core",
      "sourceId": "cissia-core",
      "label": "Fatal Concoction (Core Passive)",
      "description": "... With Venom, the squad's Electric DMG ignores 6% of enemy DEF. If initial Energy Regen is higher than 1.4, for every additional 0.12 above that threshold, an additional 1% of the enemy's DEF is ignored, up to a maximum of 25% of enemy DEF. This effect lasts until 30s after Venom is depleted. ...",
      "shortDescription": "All squad members' Electric RES Shred is increased based on Cissia's initial Energy Regen.",
      "target": "team",
      "conditional": {
        "type": "initialStatBased",
        "basedOn": "energyRegen",
        "threshold": 1.4,
        "maxStat": 99999,
        "baseBonus": 0.06,
        "perUnit": 0.12,
