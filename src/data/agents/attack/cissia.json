      "source": "core",
      "sourceId": "cissia-core",
      "label": "Festering Venom (Additional Ability)",
      "description": "When another character in your squad is a Stun character or shares the same attribute:\n\nWhile possessing Venom, increases all squad members' CRIT DMG by 40%, with Cissia gaining an additional 10%. The effect lasts until 30s after Venom is depleted.",
      "shortDescription": "Cissia's CRIT DMG is increased by 50% for 30s.",
      "target": "self",
      "flat": {
        "critDmg": 0.5
      }
    },
