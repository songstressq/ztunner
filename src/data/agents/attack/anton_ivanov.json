    {
      "id": "anton_ivanov-mindscape_1-warp_up_exercises",
      "source": "mindscape",
      "sourceId": "anton_ivanov-mindscape_1",
      "label": "Warm-Up Exercises (Mindscape Cinema N°1)",
      "description": "When Drill Attack hits an enemy, Anton gains additional Energy, up to a maximum of 5 Energy per skill use.",
      "shortDescription": "This mindscape cinema does not affect Anton's stats.",
      "infoOnly": true
    },
    {
      "id": "anton_ivanov-mindscape_2-state_of_flow",
      "source": "mindscape",
      "sourceId": "anton_ivanov-mindscape_2",
      "label": "State of Flow (Mindscape Cinema N°2)",
      "description": "When Anton uses his EX Special Attack and enters Burst Mode, he gains a Shield that equals to 7.5% of his max HP. While in Burst Mode, entering combat or switching in reapplies the Shield effect. This effect can trigger once every 15s. The Shield dissipates when Burst Mode ends.",
      "shortDescription": "This mindscape cinema does not affect Anton's stats.",
      "infoOnly": true
    },
    {
      "id": "anton_ivanov-mindscape_4-everyone_get_fired_up",
      "source": "mindscape",
      "sourceId": "anton_ivanov-mindscape_4",
      "label": "Everyone Get Fired Up! (Mindscape Cinema N°4)",
      "description": "When Anton uses a Chain Attack or Ultimate, all squad members' CRIT Rate increases by 10% for 12s.",
      "shortDescription": "All squad members's CRIT Rate is increased by 10%.",
      "target": "team",
      "flat": {
        "critRate": 0.1
      }
    },
    {
      "id": "anton_ivanov-mindscape_6-break_the_limit",
      "source": "mindscape",
      "sourceId": "anton_ivanov-mindscape_6",
      "label": "Break the Limit (Mindscape Cinema N°6)",
      "description": "When Anton's Piledriver Attack triggers a critical hit, his Basic Attack: Enthusiastic Drills (Burst Mode) and Dodge Counter: Overload Drill (Burst Mode) deal 4% more DMG for 30s, stacking up to 6 times. Repeated triggers reset the duration.",
      "shortDescription": "Anton's Enthusiastic Drills and Overload Drill DMG increases by +4%, stacking up to 6 times.",
      "target": "self",
      "maxStacks": 6,
      "damageBonuses": [
        {
          "type": "exclusive",
          "appliesTo": [
            "anton-basic_attack-enthusiastic_drills_burst",
            "anton-dodge_counter-overload_drill_burst"
          ],
          "value": 0.04
        }
      ]
    }
  ],
