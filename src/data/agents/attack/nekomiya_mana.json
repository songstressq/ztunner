    {
      "id": "nekomata-core-stealthy_paws",
      "source": "core",
      "sourceId": "nekomata-core",
      "label": "Stealthy Paws (Core Passive)",
      "description": "When Nekomata's Dodge Counter or Quick Assist hits an enemy, her DMG increases by a percentage for 6s",
