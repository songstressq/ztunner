  "ingameEffects": [
    {
      "id": "orphie_and_magus-core_1-taming_wind_and_fire_protocol",
      "source": "core",
      "sourceId": "orphie_and_magus-core",
      "label": "Taming Wind and Fire Protocol (Core Passive)",
      "description": "Orphie & Magus's CRIT Rate increases by 25%, and Aftershock DMG increases by 85%. Orphie & Magus initially gain 100 Bottled Heat, up to a maximum of 125. When Orphie & Magus are off-field, if Special Attack: Corrosive Flash is available and Energy is greater than or equal to 60, consume 30 Energy to automatically trigger EX Special Attack: Crimson Vortex instead.",
      "shortDescription": "Orphie & Magus' CRIT Rate is increased by 25% and her damage from Aftershocks is increased by 85%.",
      "target": "self",
      "flat": {
        "critRate": 0.25
      },
      "damageBonuses": [
        {
          "type": "element",
          "element": "aftershock",
          "value": 0.85
        }
      ]
    },
    {
      "id": "orphie_and_magus-core_2-taming_wind_and_fire_protocol",
      "source": "core",
      "sourceId": "orphie_and_magus-core",
      "label": "Taming Wind and Fire Protocol (Core Passive)",
      "description": "When Orphie & Magus are off-field, if Special Attack: Corrosive Flash is available and Energy is greater than or equal to 60, consume 30 Energy to automatically trigger EX Special Attack: Crimson Vortex instead. When the laser from EX Special Attack: Heat Charge hits enemies, all squad members gain Zeroed In for 12s. Repeated triggers reset the duration. Zeroed In increases Agent ATK by 280. When Orphie & Magus's initial Energy Regen is greater than or equal to 1.6, for every 0.1 initial Energy Regen above this threshold, ATK increases by an additional 20. The total increase from both initial and additional ATK increases cannot exceed 700. When an Agent with Zeroed In triggers Aftershock, their Zeroed In duration extends by 4s, up to a maximum extension of 20s.",
      "shortDescription": "All squad members' ATK is increased based on Orphie & Magus' initial Energy Regen.",
      "target": "team",
      "conditional": {
        "type": "initialStatBased",
        "basedOn": "energyRegen",
        "threshold": 1.6,
        "maxStat": 99999,
        "baseBonus": 280,
        "perUnit": 0.1,
        "skillLevels": [
          {
            "level": 1,
            "maxBonus": 700,
            "perUnitBonus": 20
          }
        ],
        "affectedStats": ["atkFlatRaw"]
      }
    },
    {
      "id": "orphie_and_magus_core_forged_in_flames",
      "source": "core",
      "sourceId": "orphie_and_magus_core_3",
      "label": "Forged in Flames (Aditional Ability)",
      "description": "WWhen another character in your squad is a Stun or Support character: Aftershock DMG dealt by Agents with Zeroed In ignores 25% DEF.",
      "shortDescription": "Aftershock DMG ignores 25% DEF.",
      "target": "self",
      "aftershockDefShred": 0.25
    },
    {
      "id": "orphie_and_magus-mindscape_1_1-luxurious_cat_house",
      "source": "mindscape",
      "sourceId": "orphie_and_magus-mindscape_1_1",
      "label": "Luxurious Cat House (Mindscape Cinema N°1)",
      "description": "Orphie & Magus' Special Attack: Corrosive Flash, EX Special Attack: Crimson Vortex, EX Special Attack: Heat Charge, and EX Special Attack: Fiery Eruption ignore 15% of target's Fire RES, and Agents with Zeroed In deal 20% increased DMG.",
      "shortDescription": "Orphie & Magus' Special Attack: Corrosive Flash, EX Special Attack: Crimson Vortex, EX Special Attack: Heat Charge, and EX Special Attack: Fiery Eruption ignore 15% of target's Fire RES.",
      "target": "self",
      "exclusiveStatBonuses": [
