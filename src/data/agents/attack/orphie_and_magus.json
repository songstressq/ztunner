    },
    {
      "id": "orphie_and_magus-mindscape_6-magic_seed",
      "source": "mindscape",
      "sourceId": "orphie_and_magus-mindscape_6",
      "label": "Magic Seed (Mindscape Cinema N°4)",
      "description": "With enough energy, after the fire blade attack of Basic Attack: High-Pressure Flamethrower, press EX Special Attack to immediately follow up with EX Special Attack: Crimson Vortex. When the fire blade attack of Basic Attack: High-Pressure Flamethrower is activated, recover 10 Bottled Heat, and the Interrupt Level during the low firepower phase of EX Special Attack: Heat Charge will also increase. When the laser from EX Special Attack: Heat Charge or Ultimate hits enemies, it deals additional Fire DMG equal to 250% of Orphie & Magus's ATK. This effect can trigger once every 0.5s and is counted as EX Special Attack and Aftershock DMG.",
      "shortDescription": "This ability is available in the Damage Calculator.",
      "infoOnly": true
    }
