    {
      "id": "orphie_and_magus-mindscape_2-weird_food_list",
      "source": "mindscape",
      "sourceId": "orphie_and_magus-mindscape_2",
      "label": "Weird Food List (Mindscape Cinema N°2)",
      "description": "When Orphie & Magus launch an Aftershock, restore 65 Decibels. This effect can trigger once every 4s. After Orphie & Magus use their Ultimate, their ATK increases by 20% for up to 45s.",
