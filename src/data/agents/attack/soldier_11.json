    {
      "id": "soldier_11-mindscape_1-rapid_heat",
      "source": "mindscape",
      "sourceId": "soldier_11-mindscape_1",
      "label": "Rapid Heat (Mindscape Cinema N°1)",
      "description": "When Soldier 11 enters combat or switches in, if her Energy is less than 40, her Energy is recovered to 80. This effect can trigger once every 50s.",
      "shortDescription": "This mindscape cinema does not affect Soldier 11's stats.",
      "infoOnly": true
    },
    {
      "id": "soldier_11-mindscape_2-scorching_convergence",
      "source": "mindscape",
      "sourceId": "soldier_11-mindscape_2",
      "label": "Scorching Convergence (Mindscape Cinema N°2)",
      "description": "When triggering Fire Suppression, Basic Attack, Dash Attack, and Dodge Counter DMG increases by 3%, up to 12 stacks, lasting 15s, with the duration of each stack calculated separately.",
      "shortDescription": "Soldier 11's DMG from Basic Attacks, Dash Attacks and Dodge Counters is increased by 3% for 15s, stacking up to 12 times.",
      "target": "self",
      "damageBonuses": [
        {
          "type": "skillType",
          "skillType": "basic",
          "value": 0.03
        },
        {
          "type": "skillType",
          "skillType": "dash",
          "value": 0.03
        },
        {
          "type": "skillType",
          "skillType": "counter",
          "value": 0.03
        }
      ],
      "maxStacks": 12
    },
    {
      "id": "soldier_11-mindscape_4-indulgent_blaze",
      "source": "mindscape",
      "sourceId": "soldier_11-mindscape_4",
      "label": "Indulgent Blaze (Mindscape Cinema N°4)",
      "description": "If Fire Suppression is triggered during the 1st, 2nd, or 3rd hit of Soldier 11's Basic Attack or a Dash Attack, Anti-Interrupt Level increases and DMG received is reduced by 18% during skill activation. If Fire Suppression is triggered during the 4th hit of her Basic Attack, she becomes invulnerable during skill activation.",
      "shortDescription": "This mindscape cinema does not affect Soldier 11's stats.",
      "infoOnly": true
    },
    {
      "id": "soldier_11-mindscape_6-scorching_flow",
      "source": "mindscape",
      "sourceId": "soldier_11-mindscape_6",
      "label": "Scorching Flow (Mindscape Cinema N°6)",
      "description": "When Soldier 11 uses her EX Special Attack, Chain Attack, or Ultimate, she gains 8 stacks of Charge (max 8 stacks). When Fire Suppression is triggered, 1 stack of Charge is consumed, causing the current move to ignore 25% of the target's Fire RES.",
      "shortDescription": "Soldier 11's DMG from EX Special Attack: Fervent Fire, Chain Attack: Uplifting Flame and Ultimate: Bellowing Flame ignores 25% of target's Fire RES.",
