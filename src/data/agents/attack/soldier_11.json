          ],
          "value": 0.7
        }
      ]
    },
    {
      "id": "soldier_11-core_1-fields_of_fire",
      "source": "core",
      "sourceId": "soldier_11-core",
      "label": "Fields of Fire (Additional Ability)",
      "description": "When another character in your squad shares the same Attribute or Faction:\n\nSoldier 11 deals 10% more Fire DMG. When attacking Stunned enemies, this effect is further enhanced by an additional 22.5%.",
      "shortDescription": "Soldier 11's Fire DMG is increased by 10%.",
      "target": "self",
