  "ingameEffects": [
    {
      "id": "soldier_11-core-heatwave",
      "source": "core",
      "sourceId": "soldier_11-core",
      "label": "Heatwave (Core Passive)",
      "description": "When triggering Fire Suppression during a Basic Attack or Dash Attack, increase that attack's DMG by 70%.",
      "shortDescription": "Soldier 11's DMG from Basic Attack: Fire Suppresion and Dash Attack: Fire Suppresion is increased by 70%.",
      "target": "self",
