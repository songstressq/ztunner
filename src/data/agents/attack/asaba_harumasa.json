  "ingameEffects": [
    {
      "id": "asaba_harumuasa-core-day_break",
      "source": "core",
      "sourceId": "asaba_harumasa-core",
      "label": "Day Break (Core Passive)",
      "description": "The CRIT Rate of Dash Attack: Hiten no Tsuru - Slash increases by 25%, and when Harumasa's Dash Attack: Hiten no Tsuru - Slash triggers a critical hit against an enemy, he gains 1 stack of Gleaming Edge, for up to a maximum of 3 stacks per use of the skill and stacking up to 6 times, lasting 5s, repeated triggers reset the duration. Each stack of Gleaming Edge increases the CRIT DMG of Dash Attack: Hiten no Tsuru - Slash by 12%",
      "shortDescription": "Increases Harumasa's CRIT DMG from Dash Attack: Hiten no Tsuru - Slash by 12%, stacking up to 3 times.",
      "target": "self",
      "exclusiveStatBonuses": [
        {
          "stat": "critDmg",
          "type": "exclusive",
          "appliesTo": ["harumasa-dash_attack-hiten_no_tsuru_slash"],
          "value": 0.12
        }
      ],
      "maxStacks": 3
    },
    {
      "id": "asaba_harumuasa-core-overclock",
      "source": "core",
      "sourceId": "asaba_harumasa-core",
      "label": "Overclock (Aditional Ability)",
      "description": "When another character in your squad is a Stun or Anomaly character:\n\nWhen Harumasa's attacks hit Stunned enemies or enemies under Attribute Anomaly, his DMG increases by 40%. When Harumasa's Falling Feather hits Stunned enemies or enemies under Attribute Anomaly, it will apply 2 stacks of Electro Prison to the target.",
      "shortDescription": "Harumasa's DMG is increased by 40% against enemies that are stunned or under an attribute anomaly.",
      "target": "self",
      "damageBonuses": [
        {
          "type": "global",
          "value": 0.4
        }
      ]
    },
    {
      "id": "asaba_harumasa-mindscape_1-high_spirit",
      "source": "mindscape",
      "sourceId": "asaba_harumasa-mindscape_1",
      "label": "High Spirit (Mindscape Cinema N°1)",
      "description": "The maximum stack limit of Electro Prison from Basic Attack: Ha-Oto no Ya increases to 14 stacks. When an Electro Quiver is triggered, 2 consecutive Ha-Oto no Ya will be fired at the target.",
      "shortDescription": "This mindscape cinema does not affect Harumasa's stats.",
      "infoOnly": true
    },
    {
      "id": "asaba_harumasa-mindscape_2-languish",
      "source": "mindscape",
      "sourceId": "asaba_harumasa-mindscape_2",
      "label": "Languish (Mindscape Cinema N°2)",
      "description": "When using an Chain Attack or Ultimate, Harumasa gains 7 stacks of Electro Blitz, up to a max of 7 stacks. While possessing Electro Blitz, the DMG of Dash Attack: Hiten no Tsuru - Slash increases by 50%. Consume 1 stack of Electro Blitz once Dash Attack: Hiten no Tsuru - Slash ends.",
      "shortDescription": "Increases Harumasa's DMG from Dash Attack: Hiten no Tsuru - Slash by 50%.",
      "target": "self",
      "damageBonuses": [
        {
          "type": "exclusive",
          "appliesTo": ["harumasa-dash_attack-hiten_no_tsuru_slash"],
          "value": 0.5
        }
      ]
    },
    {
      "id": "asaba_harumasa-mindscape_4-ocasionally_motivated",
      "source": "mindscape",
      "sourceId": "asaba_harumasa-mindscape_4",
      "label": "Occasionally Motivated (Mindscape Cinema N°4)",
      "description": "Electro Prison now lasts for 20s. When Dash Attack: Hiten no Tsuru - Slash hits enemies, Harumasa gains 30 Decibels once per use of this skill. Upon activating an Ultimate, apply the maximum stacks of Electro Prison to all on-field enemies.",
      "shortDescription": "This mindscape cinema does not affect Harumasa's stats.",
      "infoOnly": true
    },
    {
      "id": "asaba_harumasa-mindscape_6-tacit_understanding",
      "source": "mindscape",
      "sourceId": "asaba_harumasa-mindscape_6",
      "label": "Tacit Understanding (Mindscape Cinema N°6)",
      "description": "After Ha-Oto no Ya hits Stunned enemies or enemies under Attribute Anomalies, Harumasa will ignore 15% of the target's Electric RES for 12s. Every 12 times an enemy is hit by Ha-Oto no Ya, trigger an extra electromagnetic explosion, dealing 1,500% of Harumasa's ATK to the target as Electric DMG.",
      "shortDescription": "Harumasa ignores 15% of the target's Electric RES for 12s. Ha-Oto no Ya's additional damage is available in the Damage Calculator.",
      "target": "self",
      "flat": {
        "electricResShred": 0.15
      }
    }
  ],
