  "ingameEffects": [
    {
      "id": "billy_kid-core-steady_shot",
      "source": "core",
      "sourceId": "billy_kid_core",
      "label": "Steady Shot (Core Passive)",
      "description": "Billy's DMG increases by 50% when he enters Crouching Shot during his Basic Attack. The effect ends if he moves, returns to standby, or is knocked back or launched by an attack.",
      "shortDescription": "Billy's DMG is increased by 50%.",
      "target": "self",
      "damageBonuses": [
        {
          "type": "global",
          "value": 0.5
        }
      ]
    },
    {
      "id": "billy_kid-core-team_starlight",
      "source": "core",
      "sourceId": "billy_kid_core",
      "label": "Team Starlight (Aditional Ability)",
      "description": "When another character in your squad shares the same Attribute or Faction:\n\nAfter Billy uses a Chain Attack, the DMG of his next Ultimate is increased by 50%, stacking up to 2 times. This effect resets whenever an ultimate is activated.",
      "shortDescription": "Increases Billy's DMG from Ultimate: Starlight, Shine Bright by 50%, stacking up to 2 times.",
      "target": "self",
      "damageBonuses": [
        {
          "type": "exclusive",
          "appliesTo": ["billy-ultimate-starlight_shine_bright"],
          "value": 0.5
        }
      ],
      "maxStacks": 2
    },
    {
      "id": "billy_kid-mindscape_1-dazzling_entrance",
      "source": "mindscape",
      "sourceId": "billy_kid-mindscape_1",
      "label": "Dazzling Entrance (Mindscape Cinema N°1)",
      "description": "When Billy hits an enemy with a Dash Attack or Dodge Counter, he gains an additional 2.7 Energy. Can trigger once every 5s.",
      "shortDescription": "This mindscape cinema does not affect Billy's stats.",
      "infoOnly": true
    },
    {
      "id": "billy_kid-mindscape_2-roaming_gunslinger",
      "source": "mindscape",
      "sourceId": "billy_kid-mindscape_2",
      "label": "Roaming Gunslinger (Mindscape Cinema N°2)",
      "description": "Billy's Dodge Counter DMG increases by 25%. Rolling Shots during his Basic Attacks are treated as dodges, making Billy Invulnerable during the skill and able to trigger Perfect Dodges. When a Rolling Shot triggers a Perfect Dodge, it will automatically become a Dodge Counter.",
      "shortDescription": "Increases Billy's DMG from Dodge Counters by 25%.",
      "target": "self",
      "damageBonuses": [
        {
          "type": "exclusive",
          "appliesTo": ["billy-dodge_counter-fair_fight"],
          "value": 0.25
        },
        {
          "type": "hitExclusive",
          "skillId": "billy-basic_attack-full_firepower",
          "hitName": "Rolling Shot DMG Multiplier",
          "value": 0.25
        }
      ]
    },
    {
      "id": "billy_kid-mindscape_4-starlight_ballistics",
      "source": "mindscape",
      "sourceId": "billy_kid-mindscape_4",
      "label": "Starlight Ballistics (Mindscape Cinema N°4)",
      "description": "When Billy hits an enemy with his EX Special Attack, the skill's CRIT Rate is increased based on the distance from the enemy. The closer he is to the target, the greater the effect, up to a maximum increase of 32%.",
      "shortDescription": "This mindscape cinema does not affect Billy's stats.",
      "infoOnly": true
    },
    {
      "id": "billy_kid-mindscape_6-starlight_hero",
      "source": "mindscape",
      "sourceId": "billy_kid-mindscape_6",
      "label": "Starlight Hero (Mindscape Cinema N°6)",
      "description": "When Billy accumulates 10 hits on enemies or triggers a Perfect Dodge, his DMG increases by 6%, stacking up to 5 times and lasting until he's knocked back or launched by an attack.",
      "shortDescription": "Increases Billy's DMG by 6%, stacking up to 5 times.",
      "target": "self",
      "damageBonuses": [
        {
          "type": "global",
          "value": 0.06
        }
      ],
      "maxStacks": 5
    }
  ],
