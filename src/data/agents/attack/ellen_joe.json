  "ingameEffects": [
    {
      "id": "ellen_joe-core-sharp_toothed",
      "source": "core",
      "sourceId": "ellen_joe-core",
      "label": "Sharp-Toothed (Core Passive)",
      "description": "When Ellen launches a Charged Scissors strike during Dash Attack: Arctic Ambush, or consumes a Flash Freeze Charge to activate Basic Attack: Flash Freeze Trimming, the skill's CRIT DMG is increased by 100%.",
      "shortDescription": "Increases Ellen Joe's CRIT DMG from Basic Attack: Flash Freeze Trimming by 100%.",
      "target": "self",
      "exclusiveStatBonuses": [
        {
          "stat": "critDmg",
          "type": "exclusive",
          "appliesTo": ["ellen_joe-basic-flash_freeze_trimming"],
          "value": 1
        }
      ]
    },
    {
      "id": "ellen_joe-core-rising_storm",
      "source": "core",
      "sourceId": "ellen_joe-core",
      "label": "Rising Storm (Additional Ability)",
      "description": "When another character in your squad shares the same Attribute or Faction: When Ellen deals Ice DMG, subsequent Ice DMG increases by 3% for 10s. This effect can stack up to 10 times, and repeated triggers reset the duration.",
      "shortDescription": "Ellen Joe's Ice DMG is increased by 3% for 10s, stacking up to 10 times",
      "target": "self",
      "damageBonuses": [
        {
          "type": "element",
          "element": "ice",
          "value": 0.03
        }
      ],
      "maxStacks": 10
    },
    {
      "id": "ellen_joe-mindscape_1-glacial_omen",
      "source": "mindscape",
      "sourceId": "ellen_joe-mindscape_1",
      "label": "Glacial Omen (Mindscape Cinema N°1)",
      "description": "Upon hitting an enemy with Swift Scissors during Dash Attack: Arctic Ambush, the obtained Flash Freeze Charges are increased to 3. Upon hitting an enemy with Charged Scissor Strike during Dash Attack: Arctic Ambush, the obtained Flash Freeze Charge are increased to 6. For each point of Flash Freeze Charge consumed, Ellen’s CRIT Rate is increased by 2% for 15s, stacking up to 6 times. The duration of each stack is calculated separately.",
      "shortDescription": "Ellen Joe's CRIT Rate is increased by 2% for 15s, stacking up to 6 times",
      "target": "self",
      "perStack": {
        "critRate": 0.02
      },
      "maxStacks": 6
    },
    {
      "id": "ellen_joe-mindscape_2-arctic_ocean_predator",
      "source": "mindscape",
      "sourceId": "ellen_joe-mindscape_2",
      "label": "Arctic Ocean Predator (Mindscape Cinema N°2)",
      "description": "The 3rd hit of Basic Attack: Flash Freeze Trimming can be directly followed up with EX Special Attack: Sharknami. When using an EX Special Attack, each Flash Freeze Charge increases the current attack's CRIT DMG by 20%, up to a maximum of 60%.",
      "shortDescription": "Ellen Joe's CRIT DMG from EX Special Attacks is increased by 20%, stacking up to 3 times",
      "target": "self",
      "exclusiveStatBonuses": [
        {
          "stat": "critDmg",
          "type": "exclusive",
          "appliesTo": [
            "ellen_joe-ex_special_attack-sharknami",
            "ellen_joe-ex_special_attack-tail_swipe"
          ],
          "value": 0.2
        }
      ],
      "maxStacks": 3
    },
    {
      "id": "ellen_joe-mindscape_4-endless_hoarfrost",
      "source": "mindscape",
      "sourceId": "ellen_joe-mindscape_4",
      "label": "Endless Hoarfrost (Mindscape Cinema N°4)",
      "description": "Whenever a squad member Freezes or Stuns an enemy, Ellen gains 6 Flash Freeze Charges and the Quick Charge effect. She also recovers 4 Energy. The Energy recovery effect can trigger once per 10s.",
      "shortDescription": "This mindscape cinema does not affect Ellen Joe's stats.",
      "infoOnly": true
    },
    {
      "id": "ellen_joe-mindscape_6_1-the_feast_begins",
      "source": "mindscape",
      "sourceId": "ellen_joe-mindscape_6",
      "label": "The Feast Begins (Mindscape Cinema N°6)",
      "description": "When Ellen uses an EX Special Attack, Chain Attack, or gains Quick Charge, her PEN Ratio increases by 20% for 6s. She also gains 1 stack of The Feast Begins, up to a maximum of 3 stacks. With 3 stacks of The Feast Begins, using a Charged Scissors strike during Dash Attack: Arctic Ambush consumes all stacks, increasing the DMG of the current attack by 250%.",
      "shortDescription": "Ellen Joe's PEN Ratio is increased by 20% for 6s.",
      "target": "self",
      "flat": {
        "penRatio": 0.2
      }
    },
    {
      "id": "ellen_joe-mindscape_6_2-the_feast_begins",
      "source": "mindscape",
      "sourceId": "ellen_joe-mindscape_6",
      "label": "The Feast Begins (Mindscape Cinema N°6)",
      "description": "When Ellen uses an EX Special Attack, Chain Attack, or gains Quick Charge, her PEN Ratio increases by 20% for 6s. She also gains 1 stack of The Feast Begins, up to a maximum of 3 stacks. With 3 stacks of The Feast Begins, using a Charged Scissors strike during Dash Attack: Arctic Ambush consumes all stacks, increasing the DMG of the current attack by 250%.",
      "shortDescription": "Ellen Joe's DMG from Charged Scissors is increased by 250%.",
      "target": "self",
      "flat": {
        "penRatio": 0.2
      },
