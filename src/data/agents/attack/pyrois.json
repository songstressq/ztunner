  "ingameEffects": [
    {
      "id": "pyrois-core_1-radiant_chariot",
      "source": "core",
      "sourceId": "pyrois-core",
      "label": "Radiant Chariot (Core Passive)",
      "description": "... Upper Branch - Ultimate: Total Annihilation: Gain 30 Solar Prominence and enter the Mirage state. While in the Mirage state, Pyrois' Ultimate deals 40% increased CRIT DMG against Stunned enemies, and with 30 or more Solar Prominence hold Basic Attack during the 4th hit of Basic Attack: Celestial Light to immediately follow up with the 3rd hit of Basic Attack: Celestial Light. This effect lasts 21s. Repeated triggers reset the duration. ...",
      "shortDescription": "While in the Mirage state, Pyrois's CRIT DMG from Ultimates is increased by 40% for 21s against stunned enemies.",
      "target": "self",
      "exclusiveStatBonuses": [
        {
          "stat": "critDmg",
          "type": "exclusive",
          "appliesTo": [
            "pyrois-ultimate-total_annihilation",
            "pyrois-ultimate-triumphant_return",
            "pyrois-ultimate-unbound_swordstorm",
            "pyrois-ultimate-eternal_imprisonment"
          ],
          "value": 0.4
        }
      ]
    },
    {
      "id": "pyrois-core_2-radiant_chariot",
      "source": "core",
      "sourceId": "pyrois-core",
      "label": "Radiant Chariot (Core Passive)",
      "description": "... Lower Branch - Ultimate: Triumphant Return: Enter the Sunflare state. While in the Sunflare state, Energy Generation Rate increases by 15%, and DMG dealt increases by 40%, and triggering a Perfect Block with an EX Special Attack grants 10 Solar Prominence. This effect lasts 200s. Repeated triggers reset the duration. ...",
      "shortDescription": "While in the Sunflare state, Pyrois's DMG is increased by 40% for 200s.",
      "target": "self",
      "damageBonuses": [
        {
          "type": "global",
          "value": 0.4
        }
      ]
    },
    {
      "id": "pyrois-core_3-radiant_chariot",
      "source": "core",
      "sourceId": "pyrois-core",
      "label": "Radiant Chariot (Core Passive)",
      "description": "... Left Branch - Ultimate: Unbound Swordstorm: Heavy attacks that hit enemies in the Contamination state deal 900% of ATK as additional DMG. ...",
      "shortDescription": "Pyrois' additional damage from heavy attacks is available in the Damage Calculator.",
      "infoOnly": true
    },
    {
      "id": "pyrois-core-glorious_legion",
      "source": "core",
      "sourceId": "pyrois-core",
      "label": "Glorious Legion (Additional Passive)",
      "description": "When another character in your squad is a Stun or Support character:\n\nPyrois' CRIT DMG increases by 40%. Using a Chain Attack grants 300 Decibels.",
      "shortDescription": "Pyrois' CRIT DMG is increased by 40%.",
      "target": "self",
      "flat": {
        "critDmg": 0.4
      }
    },
    {
      "id": "pyrois-mindscape_1-shadows_of_twilight_past",
