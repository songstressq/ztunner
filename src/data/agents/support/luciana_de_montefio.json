    {
      "id": "luciana_de_montefio-special_attack-cheer_on",
      "source": "special_attack",
      "sourceId": "luciana_de_montefio-special_attack",
      "label": "Cheer On! (Special Attack)",
      "description": "After using EX Special Attack, when a guard boar triggers an explosion, it will apply the Cheer On! status to all squad members and Bangboo, and the guard boars themselves. While under the Cheer On! status, allies' ATK increases by a percentage of Lucy's initial ATK plus a set amount, up to a maximum of 600. The Cheer On! status lasts for 10s when a Line Drive is hit, and 15s when a Fly Ball is hit. Repeated triggers reset the duration.",
      "shortDescription": "All squad members' ATK is increased based on Lucy's initial ATK.",
      "target": "team",
