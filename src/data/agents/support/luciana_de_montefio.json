    {
      "id": "luciana_de_montefio-mindscape_1-drill_formations",
      "source": "mindscape",
      "sourceId": "luciana_de_montefio-mindscape_1",
      "label": "Drill Formations (Mindscape Cinema N°1)",
      "description": "When the guard boars launch Guard Boars: Spinning Swing!, Lucy recovers 2 Energy. This effect can trigger once every 15s, with each guard boar having its own separate cooldown.",
      "shortDescription": "This mindscape cinema does not affect Lucy's stats.",
      "infoOnly": true
    },
    {
      "id": "luciana_de_montefio-mindscape_2-little_boar_captain",
      "source": "mindscape",
      "sourceId": "luciana_de_montefio-mindscape_2",
      "label": "Little Boar Captain (Mindscape Cinema N°2)",
      "description": "When Lucy uses a Chain Attack or Ultimate, it grants all squad members and Bangboo, and the guard boars themselves the Cheer On! status for 10s.",
      "shortDescription": "This mindscape cinema does not affect Lucy's stats.",
      "infoOnly": true
    },
    {
      "id": "luciana_de_montefio-mindscape_4-chaos_ball_game",
      "source": "mindscape",
      "sourceId": "luciana_de_montefio-mindscape_4",
      "label": "Chaos Ball Game (Mindscape Cinema N°4)",
      "description": "While in the Cheer On! state, allies' CRIT DMG is increased by an additional 10%.",
      "shortDescription": "All Squad Members' CRIT DMG is increased by 10%.",
      "target": "team",
      "flat": {
        "critDmg": 0.1
      }
    },
    {
      "id": "luciana_de_montefio-mindscape_6-fierce_fangs_of_fire",
      "source": "mindscape",
      "sourceId": "luciana_de_montefio-mindscape_6",
      "label": "Fierce Fangs of Fire (Mindscape Cinema N°6)",
      "description": "When another squad member in the Cheer On! state hits an enemy with an EX Special Attack, a guard boar will drop from the sky and cause an explosion, dealing Fire DMG equal to 300% of the guard boar's ATK. This will extend the duration of the Cheer On! buff for all squad members and Bangboo, and for the guard boars themselves by 5s. The duration can increase up to 3 times, with a maximum duration of 30s. Refreshing the Cheer On! state resets the stack count. After the guard boar's explosion, it will launch Guard Boars: Spinning Swing!.",
      "shortDescription": "This ability is available in the Damage Calculator.",
      "infoOnly": true
    }
  ],
