  "ingameEffects": [
    {
      "id": "ukinami_yuzuha-core-whimsical_wonder",
      "source": "core",
      "sourceId": "ukinami_yuzuha-core",
      "label": "Whimsical Wonder (Core Passive)",
      "description": "Upon entering the battlefield, Yuzuha immediately gains 3 Sugar Points. Yuzuha can have up to 6 Sugar Points. When Yuzuha's EX Special Attack: Cavity Alert, EX Special Attack: Cavity Alert, Right Now!, or Ultimate: Surrender or Suffer the Mischief hits an enemy, all squad members receive the Tanuki Wish effect. Tanuki Wish grants an ATK increase equal to 40% of Yuzuha's initial ATK, up to a maximum increase of 1200, and increases the DMG dealt by those with the effect by 15%, lasting 40s. Repeated triggers reset the duration. If Yuzuha's initial ATK reaches 3000, she grants the full ATK bonus to all squad members.",
      "shortDescription": "All squad members' ATK is increased based on Yuzuha's Initial ATK for 40s, and their DMG is increased by 15% for 40s.",
      "target": "team",
      "damageBonuses": [
        {
          "type": "global",
          "value": 0.15
        }
      ],
      "conditional": {
        "type": "initialStatBased",
        "basedOn": "atk",
        "maxStat": 3000,
        "baseBonus": 0,
        "perUnit": 1,
        "skillLevels": [
          {
            "level": 1,
            "maxBonus": 1200,
            "perUnitBonus": 0.4
          }
        ],
        "affectedStats": ["atkFlatRaw"]
      }
    },
    {
      "id": "ukinami_yuzuha-core-the_more_the_merrier",
      "source": "core",
      "sourceId": "ukinami_yuzuha-core",
      "label": "The More the Merrier (Additional Ability)",
      "description": "When another character in your squad is an Anomaly character or shares the same Faction:\n\nIf Yuzuha's Anomaly Mastery exceeds 100, every point over increases the Anomaly Buildup Rate of characters with Tanuki Wish by 0.2%, up to a maximum of 20%, and all Attribute Anomaly DMG and Disorder DMG by 0.2%, up to a maximum of 20%. When Yuzuha's Anomaly Mastery is at 200, she grants the full buff effect.",
      "shortDescription": "All squad members' DMG from Attribute Anomalies or Disorders is increased based on Yuzuha's current Anomaly Mastery.",
      "target": "team",
      "conditional": {
        "type": "currentStatBased",
        "basedOn": "anomalyMastery",
        "threshold": 100,
        "perUnit": 1,
        "perUnitBonus": 0.002,
        "maxBonus": 0.2,
        "affectedStats": ["anomalyDmgBonus", "disorderDmgBonus"],
        "affectsAnomaly": true,
        "affectsDisorder": true
      }
    },
    {
      "id": "ukinami_yuzuha-mindscape_1-lucky_constitution",
      "source": "mindscape",
      "sourceId": "ukinami_yuzuha-mindscape_1",
      "label": "Lucky Constitution (Mindscape Cinema N°1)",
      "description": "Yuzuha regains 30 Energy when she enters the battlefield. In Investigation Zone Mode, this effect can trigger at most once every 180s. Enemies in the Sweet Scare state have their All-Attribute RES reduced by 10%. The Attribute Anomaly DMG and Disorder DMG buff from her Additional Ability is increased to 130% of its original value.",
      "shortDescription": "All squad members' attacks ignore 10% of the target All-Attribute RES.",
      "target": "team",
      "perStack": {
        "fireResShred": 0.1,
        "iceResShred": 0.1,
        "electricResShred": 0.1,
        "physicalResShred": 0.1,
        "etherResShred": 0.1,
        "windResShred": 0.1
      }
    },
    {
      "id": "ukinami_yuzuha-mindscape_2-full_of_colorful_company",
      "source": "mindscape",
      "sourceId": "ukinami_yuzuha-mindscape_2",
      "label": "Full of Colorful Company (Mindscape Cinema N°2)",
      "description": "When Yuzuha's EX Special Attack: Cavity Alert, EX Special Attack: Cavity Alert, Right Now!, or Ultimate: Surrender or Suffer the Mischief hits an enemy, all squad members' DMG increases by 15% and Anomaly Buildup Rate by 15%, lasting 40s and repeated triggers reset the duration. When a heavy attack hits an enemy that is not Stunned, it will trigger a forced Chain Attack. Chain Attacks triggered this way have reduced Interrupt Level and forced Chain Attacks can only occur once every 20s. Whenever another character enters through a Chain Attack, Yuzuha gains 1 Sugar Points. Yuzuha's Basic Attack: Hard Candy Shot cooldown is reduced by 25%.",
      "shortDescription": "All squad members' DMG is increased by 15% for 14s.",
      "target": "team",
      "damageBonuses": [
        {
          "type": "global",
          "value": 0.15
        }
      ]
    },
    {
      "id": "ukinami_yuzuha-mindscape_4-falling_magic",
      "source": "mindscape",
      "sourceId": "ukinami_yuzuha-mindscape_4",
      "label": "Falling Magic (Mindscape Cinema N°4)",
      "description": "The DMG from Yuzuha's Assist Follow-Up: Stuffed Hard Candy Shot and Assist Follow-Up: We Have Cookies increases by 30%, Anomaly Buildup Rate by 20%, and triggers a Quick Assist when it hits an enemy.",
      "shortDescription": "Yuzuha's DMG from Assist Follow-Up: Stuffed Hard Candy Shot and Assist Follow-Up: We Have Cookies is increased by 30%.",
      "target": "self",
      "damageBonuses": [
        {
          "type": "exclusive",
          "appliesTo": [
            "yuzuha-assist_follow_up-we_have_cookies",
            "yuzuha-assist_follow_up-stuffed_hard_candy_shot"
          ],
          "value": 0.3
        }
      ]
    },
    {
      "id": "ukinami_yuzuha-mindscape_6-put_down_roots",
      "source": "mindscape",
      "sourceId": "ukinami_yuzuha-mindscape_6",
      "label": "Put Down Roots (Mindscape Cinema N°6)",
      "description": "Gain 1 additional Sugar Points when successfully parrying an enemy attack using a Defensive Assist or Basic Attack: Tanuki Cloak. When using Assist Follow-Up: Stuffed Hard Candy Shot, hold Basic Attack to charge for up to 0.8 seconds. Releasing Basic Attack or reaching full charge fires an extra powerful shell at the enemy. For every 0.4s charged, Yuzuha consumes 1 Sugar Point to fire an additional powerful shell, each dealing 300% of her ATK as Physical DMG. If any powerful shell from Assist Follow-Up: Stuffed Hard Candy Shot hits an enemy, all squad members' Disorder DMG Multiplier increases by 105% for 40s, and stacking up to 3 times, with each stack duration being calculated separately. In addition, if the powerful shell hits an enemy under Sweet Scare, it'll trigger 1 Basic Attack: Sugarburst Sparkles - Max attack. If Yuzuha is attacked while charging, she will automatically dodge the attack and immediately unleash the max-charged attack.",
      "shortDescription": "This ability is available in the Damage Calculator.",
      "infoOnly": true
    }
  ],
