  "ingameEffects": [
    {
      "id": "sunna-ex_special_attack-ether_veil_delusion_reprise",
      "source": "ex_special_attack",
      "sourceId": "sunna-ex_special_attack",
      "label": "Ether Veil: Delusion Reprise (EX Special Attack)",
      "description": "... Before the heavy attack is executed, activates Ether Veil: Delusion Reprise. While Ether Veil: Delusion Reprise is active, all squad members gain an additional 50 ATK for 40s. Re-activating Ether Veil: Delusion Reprise will cancel the existing instance of Ether Veil: Delusion Reprise. ...",
      "shortDescription": "All squad members' ATK is increased by 50 while Ether Veil: Delusion Reprise is active.",
      "target": "team",
      "flat": {
        "atkFlatRaw": 50
      }
    },
    {
      "id": "sunna-core_1-cuteness_is_justice",
      "source": "core",
      "sourceId": "sunna-core",
      "label": "Cuteness is Justice (Core Passive)",
      "description": "Characters in the Angelic Chord-ination state gain increased ATK, equal to 30% of Sunna's initial ATK, up to a maximum of 1050 ATK. When Sunna's initial ATK reaches 3500, the ATK bonus granted to all squad members reaches its maximum...",
      "shortDescription": "All squad members' ATK is increased based on Sunna's initial ATK.",
      "target": "team",
      "conditional": {
        "type": "initialStatBased",
        "basedOn": "atk",
        "maxStat": 3500,
        "baseBonus": 0,
        "perUnit": 1,
        "perUnitBonus": 0.3,
        "skillLevels": [
          {
            "level": 1,
            "maxBonus": 1050,
            "perUnitBonus": 0.3
          }
        ],
        "affectedStats": ["atkFlatRaw"]
      }
    },
    {
      "id": "sunna-core_2-cuteness_is_justice",
      "source": "core",
      "sourceId": "sunna-core",
      "label": "Cuteness Is Justice (Core Passive)",
      "description": "When Attack or Anomaly characters in the squad continuously land attacks on enemies affected by Cat's Gaze, Cat's Gaze is triggered and removed:\n\nWhen triggered by an Attack character, deals the Agent's Attribute DMG equal to 300% of ATK to enemies in an area. When triggered by an Anomaly character, deals the Agent's Attribute DMG equal to 480% of ATK to enemies in an area. This DMG is guaranteed to CRIT, and the CRIT DMG is increased by 150%.",
      "shortDescription": "Sunna triggers bonus damage based on her squad member's specialty.",
      "target": "self",
      "requiresManualTarget": true,
      "referenceStatEffect": {
        "type": "referenceStat",
        "referenceSlot": "specific",
        "statToRead": "atk",
        "multiplier": 3,
        "appliesTo": {
          "skillIds": ["sunna-cats_gaze_trigger_damage"]
        },
        "specialtyMultipliers": {
          "Attack": 3,
          "Anomaly": 4.8
        },
        "specialtyStats": {
          "Attack": "atk",
          "Anomaly": "atk"
        },
        "guaranteedCrit": true,
        "bonusCritDmg": 1.5
      }
    },
    {
      "id": "sunna-mindscape_1-loneliness_corruption_symptoms",
      "source": "mindscape",
      "sourceId": "sunna-mindscape_1",
      "label": "Loneliness Corruption Symptoms (Mindscape Cinema N°1)",
      "description": "When Sunna enters the battlefield, she gains 15 Energy. In Investigation Zone Mode, this effect can trigger once every 180s. When Cat's Gaze triggers and damages an enemy, the target's DEF is reduced by 7% for 40s, stacking up to 3 times. The duration of each stack is calculated separately.",
      "shortDescription": "The target's DEF is reduced reduced by 7% for 40s, stacking up to 3 times.",
      "target": "team",
      "flat": {
        "defShred": 0.07
      },
      "maxStacks": 3
    },
    {
      "id": "sunna-mindscape_2-feline_go_with_the_flow",
      "source": "mindscape",
      "sourceId": "sunna-mindscape_2",
      "label": "Feline Go-With-the-Flow (Mindscape Cinema N°2)",
      "description": "While Sunna is within any Ether Veil, all squad members gain 10% ATK and she obtains 1 Claw Sharpener every 10s. The number of attacks required to trigger Cat's Gaze is reduced, and the DMG Multiplier on trigger is increased: When triggered by an Attack character, the DMG Multiplier is increased by 200%. When triggered by an Anomaly character, the DMG Multiplier is increased by 300%.",
      "shortDescription": "All squad members' ATK is increased by 10% within any Ether Veil.",
      "target": "team",
      "flat": {
        "atkPercentRaw": 0.1
      }
    },
    {
      "id": "sunna-mindscape_4-delusion_investigation_team",
      "source": "mindscape",
      "sourceId": "sunna-mindscape_4",
      "label": "Delusion Investigation Team (Mindscape Cinema N°4)",
      "description": "When Sunna uses her Ultimate, all squad members deal 18% increased DMG for 60s.",
      "shortDescription": "All squad members' DMG is increased by 18% for 60s.",
      "target": "team",
      "damageBonuses": [
        {
          "type": "global",
          "value": 0.18
        }
      ]
    },
    {
      "id": "sunna-mindscape_6-hollow_big_bang",
      "source": "mindscape",
      "sourceId": "sunna-mindscape_6",
      "label": "Hollow Big Bang (Mindscape Cinema N°6)",
      "description": "When Sunna uses an EX Special Attack, she enters the Focused Creation! state for 8s. While in the Focused Creation! state, all attacks Sunna performs are guaranteed to CRIT, and her CRIT DMG increases by 0.03% of her initial ATK, up to a maximum of 105%. While in the Focused Creation! state, Sunna's Anti-Interrupt Level is increased, and DMG taken is reduced by 40%. While in the Focused Creation! state, Sunna can trigger Cat's Gaze, its DMG being calculated using Attack Agent rules. If Cat's Gaze is triggered while Sunna has a Claw Sharpener, the Claw Sharpener is immediately consumed, and Cat's Gaze is reapplied to the enemy. While in the Focused Creation! state, DMG dealt when any squad member triggers Cat's Gaze increases by 50%.",
      "shortDescription": "Sunna's CRIT DMG is increased based on her initial ATK.",
      "target": "self",
      "conditional": {
        "type": "initialStatBased",
        "basedOn": "atk",
        "maxStat": 3500,
        "baseBonus": 0,
        "perUnit": 1,
        "perUnitBonus": 0.0003,
        "skillLevels": [
          {
            "level": 1,
            "maxBonus": 1.05,
            "perUnitBonus": 0.0003
          }
        ],
        "affectedStats": ["critDmg"]
      },
      "damageBonuses": [
        {
          "type": "exclusive",
          "appliesTo": ["sunna-cats_gaze_trigger_damage"],
          "value": 0.5
        }
      ]
    }
  ],
