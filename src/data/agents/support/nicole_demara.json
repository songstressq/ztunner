  "ingameEffects": [
    {
      "id": "nicole_demara-core-mechanical_case",
      "source": "core",
      "sourceId": "nicole_demara-core",
      "label": "Mechanical Case (Core Passive)",
      "description": "WAfter hitting an enemy with a Special Attack, EX Special Attack, Chain Attack, or Ultimate, Nicole can reload, enhance her Basic Attack and Dash Attack. When her enhanced bullets or Energy Field hits an enemy, the target's DEF is reduced by 40% for 3.5s.",
      "shortDescription": "The target's DEF is reduced by 40% for 3.5s.",
      "target": "team",
      "flat": {
        "defShred": 0.4
      }
    },
    {
      "id": "nicole_demara-core-stormy_nights_fright",
      "source": "core",
      "sourceId": "nicole_demara-core",
      "label": "Stormy Night's Fright (Additional Passive)",
      "description": "When another character in your squad shares the same Attribute or Faction: When Nicole's Core Passive: Mechanical Case applies a debuff to an enemy, all units deal 25% more Ether DMG to the target for 3.5s.",
      "shortDescription": "All squad members' Ether DMG is increased by 25% for 3.5s.",
      "target": "team",
      "damageBonuses": [
        {
          "type": "element",
          "element": "ether",
          "value": 0.25
        }
      ]
    },
    {
      "id": "nicole_demara-mindscape_1-supercharged_bomb",
      "source": "mindscape",
      "sourceId": "nicole_demara-mindscape_1",
      "label": "Supercharged Bomb (Mindscape Cinema N°1)",
      "description": "The DMG and the Anomaly Buildup inflicted by Nicole's EX Special Attack increases by 16%. For each additional 0.1s of charging when Nicole activates her EX Special Attack, the duration of the energy field created at the target location increases by 0.15s.",
      "shortDescription": "Nicole's DMG from EX Special Attack: Stufed Sugarcoated Bullet is increased by 16%.",
      "target": "self",
      "damageBonuses": [
        {
          "type": "exclusive",
          "appliesTo": ["nicole-ex_special_attack-stuffed_sugarcoated_bullet"],
          "value": 0.16
        }
      ]
    },
    {
      "id": "nicole_demara-mindscape_2-charging_device",
      "source": "mindscape",
      "sourceId": "nicole_demara-mindscape_2",
      "label": "Charging Device (Mindscape Cinema N°2)",
      "description": "Nicole recovers 5 Energy when Core Passive: Mechanical Case's debuff is triggered. This effect can trigger once every 15s.",
      "shortDescription": "This mindscape cinema does not affect Nicole's stats.",
      "infoOnly": true
    },
    {
      "id": "nicole_demara-mindscape_4-field_expansion",
      "source": "mindscape",
      "sourceId": "nicole_demara-mindscape_4",
      "label": "Field Expansion (Mindscape Cinema N°4)",
      "description": "When Nicole uses her EX Special Attack, Chain Attack, or Ultimate, the diameter of the energy field generated at the target location is increased by 3m.",
      "shortDescription": "This mindscape cinema does not affect Nicole's stats.",
      "infoOnly": true
    },
    {
      "id": "nicole_demara-mindscape_6-corrupting_energy_field",
      "source": "mindscape",
      "sourceId": "nicole_demara-mindscape_6",
      "label": "Corrupting Energy Field (Mindscape Cinema N°6)",
      "description": "When Nicole's energy fields deal DMG to an enemy, all units' CRIT Rate against that enemy increases by 1.5%, stacking up to 10 times, and lasting 12s. The duration of each stack is calculated separately.",
      "shortDescription": "All Squad Members' CRIT Rate is increased by 1.5% for 12s, stacking up to 10 times.",
      "target": "team",
      "maxStacks": 10,
      "perStack": {
        "critRate": 0.015
      }
    }
  ],
