    {
      "id": "lucia_elowen-core_1-lost_nocturne",
      "source": "core",
      "sourceId": "lucia_elowen-core",
      "label": "Lost Nocturne (Core Passive)",
      "description": "When entering the battlefield, Lucia immediately gains 60 Dream Points. If her Dream Points reaches 100 upon activating a Whim or Harmony, she enters the Dream state. When entering the Dream state, it triggers a Quick Assist and simultaneously activates Ether Veil: Wellspring. While Ether Veil: Wellspring is active, all squad members' Max HP increase by 5%, lasting 40s. Repeated triggers extend the duration, up to a max of 300s. ...",
      "shortDescription": "All squad members' Max HP is increased by 5% while Ether Veil: Wellspring is active.",
      "target": "team",
      "flat": {
        "hpPercentRaw": 0.05
      }
    },
    {
      "id": "lucia_elowen-core_2-lost_nocturne",
      "source": "core",
      "sourceId": "lucia_elowen-core",
      "label": "Lost Nocturne (Core Passive)",
      "description": "... While Lucia is in the Dream state, using any Whim consumes 25 Dream Points and upgrades it to Harmony. Whenever another active character's attack hits an enemy, Lucia consumes 25 Dream Points to unleash an Aftershock. This Aftershock is a Harmony. After Lucia triggers a skill upgrade or Aftershock, Aftershock cannot be triggered for 8s.\n\nWhen Lucia triggers a skill upgrade or an Aftershock, all squad members gain the Dreamer's Nursery Rhyme state. While in Dreamer's Nursery Rhyme state, DMG dealt increases for 12s. Repeated triggers reset the duration. If Lucia runs out of Dream Points or she leaves the Ether Veil, she exits the Dream state.",
      "shortDescription": "All squad members' DMG is increased by 20% for 12s.",
      "target": "team",
      "damageBonuses": [
        {
          "type": "global",
          "value": 0.2
        }
      ]
    },
    {
      "id": "lucia_elowen-core-ballad_of_the_long_night",
      "source": "core",
      "sourceId": "lucia_elowen-core",
      "label": "Ballad of the Long Night (Aditional Ability)",
      "description": "When another character in your squad is a Rupture or Stun character:\n\nWhen applying Darkbreaker, additionally applies a 30% CRIT DMG increase effect.",
      "shortDescription": "All squad members' CRIT DMG is increased by 30%.",
      "target": "team",
      "flat": {
        "critDmg": 0.3
      }
    },
    {
