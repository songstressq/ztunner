    {
      "id": "alexandrina_sebastiane-core-mini_destruction_partner",
      "source": "core",
      "sourceId": "alexandrina_sebastiane-core",
      "label": "Mini Destruction Partner (Core Passive)",
      "description": "When ordering Drusilla or Anastella to attack, other squad members' PEN Ratio increases together with Rina's, by 25% of Rina's PEN Ratio + 12%, up to 30%. The effect ends when both Drusilla and Anastella return to Rina.",
