  "ingameEffects": [
    {
      "id": "soukaku-core_1-blade_banner",
      "source": "core",
      "sourceId": "soukaku-core",
      "label": "Blade Banner (Core Passive)",
      "description": "When Soukaku launches Fly the Flag, her ATK is increased by 20%, up to 500, for 22s. When consuming Vortex during Fly the Flag, the ATK increase is doubled, up to a max of 1,000. This buff can be passed along to characters switching in via Quick Assists or Chain Attacks triggered by Fly the Flag, and it refreshes the duration of the buff.",
      "shortDescription": "Agents' ATK is increased based on Soukaku's initial ATK.",
      "target": "team",
