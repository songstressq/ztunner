  "ingameEffects": [
    {
      "id": "promeia-core-thief_of_flames",
      "source": "core",
      "sourceId": "promeia-core",
      "label": "Thief of Flames (Core Passive)",
      "description": "If Promeia's initial Anomaly Mastery exceeds 150, each additional point increases her Anomaly Proficiency by 1.5 and increases the whole squad's Abloom DMG by 0.35%. ...",
      "shortDescription": "Promeia's Anomaly Proficiency is increased based on her initial Anomaly Mastery.",
      "target": "self",
      "conditional": {
        "type": "initialStatBased",
        "basedOn": "anomalyMastery",
        "threshold": 150,
        "baseBonus": 0,
        "perUnit": 1,
        "skillLevels": [
          {
            "level": 1,
            "maxBonus": 99999,
            "perUnitBonus": 1.5
          }
        ],
        "affectedStats": ["anomalyProficiency"]
      }
    },
    {
      "id": "promeia-mindscape_1-innocent_idealism",
      "source": "mindscape",
      "sourceId": "promeia-mindscape_1",
      "label": "Innocent Idealism (Mindscape Cinema N°1)",
      "description": "When Promeia uses Ultimate: Glaciating Impalement, she gains an additional effect: if Trial by Cold points are not at maximum, gain 1 point of Trial by Cold. This effect can trigger once after using Ultimate: Glaciating Impalement. When any squad member triggers Abloom on enemies with Presumption of Guilt, it ignores an additional 20% DEF.",
      "shortDescription": "This mindscape cinema does not affect Promeia's stats.",
      "infoOnly": true
    },
    {
      "id": "promeia-mindscape_2-faltering_conviction",
      "source": "mindscape",
      "sourceId": "promeia-mindscape_2",
      "label": "Faltering Conviction (Mindscape Cinema N°2)",
      "description": "Promeia's Anomaly Proficiency increases by 40. The multiplier of Abloom triggered by consuming Trial by Cold increases by 120%.",
      "shortDescription": "Promeia's Anomaly Proficiency is increased by 40.",
      "target": "self",
      "flat": {
        "anomalyProficiency": 40
      }
    },
    {
      "id": "promeia-mindscape_4-ruthless_accusation",
      "source": "mindscape",
      "sourceId": "promeia-mindscape_4",
      "label": "Ruthless Accusation (Mindscape Cinema N°4)",
      "description": "When Promeia triggers Abloom, she restores 5 Corrosive Chill. This effect can trigger once every 0.5s.",
      "shortDescription": "This mindscape cinema does not affect Promeia's stats.",
      "infoOnly": true
    },
    {
      "id": "promeia-mindscape_6-to_be_continued",
      "source": "mindscape",
      "sourceId": "promeia-mindscape_6",
      "label": "To Be Continued (Mindscape Cinema N°6)",
      "description": "When Promeia consumes Trial by Cold to trigger Abloom, it triggers an additional special Abloom effect, dealing Attribute Anomaly DMG of the corresponding attribute at a fixed 200% multiplier. 5 Corrosive Chill and 100 Decibels are also restored. This effect can trigger at most once every 15s. In addition, Attribute Anomaly DMG and Disorder DMG dealt by Promeia ignore 15% of enemies' All-Attribute RES.",
      "shortDescription": "Promeia's Anomaly and Disorder DMG ignores 15% of the target's All-Attribute RES.",
      "target": "self",
      "flat": {
        "iceResShred": 0.15,
        "etherResShred": 0.15,
        "fireResShred": 0.15,
        "electricResShred": 0.15,
        "physicalResShred": 0.15,
        "windResShred": 0.15
      },
      "condition": {
        "appliesToAnomalyOnly": true,
        "appliesToDisorderOnly": true
      }
    }
  ],
