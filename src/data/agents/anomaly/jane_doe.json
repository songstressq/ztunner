  "ingameEffects": [
    {
      "id": "jane_doe-basic_attack-passion",
      "source": "basic_attack",
      "sourceId": "jane_doe-basic_attack",
      "label": "Passion (Basic Attack)",
      "description": "When Jane triggers Perfect Dodge, Defensive Assist, or performs a move that deals damage to the enemy, she accumulates Passion Stream. Upon reaching the maximum Passion Stream, Jane enters the Passion state.\n\nWhile in the Passion state, Jane's Physical Anomaly Buildup Rate is increased by 25%. Additionally, if Jane's Anomaly Proficiency exceeds 120 points, each extra point raises her ATK by 2, up to a maximum of 600. In the Passion state, Jane's skills that deal damage expend Passion Stream. Activating a Perfect Dodge or Defensive Assist regenerates Passion Stream. Jane exits the Passion state when all of her Passion Stream is expended.",
      "shortDescription": "Jane Doe's ATK is increased based on her current Anomaly Proficiency.",
      "target": "self",
      "conditional": {
        "type": "currentStatBased",
        "basedOn": "anomalyProficiency",
        "threshold": 120,
        "perUnit": 1,
        "perUnitBonus": 2,
        "maxBonus": 600,
        "affectedStats": ["atkFlatRaw"],
        "affectsAnomaly": false,
        "affectsDisorder": false
      }
    },
    {
      "id": "jane_doe-core-insight",
      "source": "core",
      "sourceId": "jane_doe-core",
      "label": "Insight (Core Passive)",
      "description": "When Jane's attacks hit an enemy, it causes them to enter the Gnawed state, lasting for 10s. If any squad member triggers Assault on an enemy in the Gnawed state and causes the Flinch effect, the Flinch effect duration is extended by 5s. Assault DMG has a chance to trigger a critical hit against enemies in the Gnawed state, with a base CRIT Rate of 40% and CRIT DMG of 50%. Each point of Jane's Anomaly Proficiency further increases this CRIT Rate by 0.16%.",
      "shortDescription": "All squad members' Assaults can trigger critical hits with a base CRIT DMG of 50%.",
      "target": "team",
      "assaultCritDmgBase": 0.5
    },
    {
      "id": "jane_doe-mindscape_1-crime_counsel",
      "source": "core",
      "sourceId": "jane_doe-mindscape_1",
      "label": "Crime Counsel (Mindscape Cinema N°1)",
      "description": "The maximum uses of Basic Attack: Salchow Jump are increased by one. While in the Passion state, Jane's Physical Anomaly Buildup Rate increases by an extra 15% and each point of Jane's Anomaly Proficiency increases her damage by 0.1%, up to a maximum of 30%.",
      "shortDescription": "Jane Doe's DMG is increased based on her current Anomaly Proficiency.",
      "target": "self",
      "conditional": {
        "type": "currentStatBased",
        "basedOn": "anomalyProficiency",
        "threshold": 0,
        "perUnit": 1,
        "perUnitBonus": 0.001,
        "maxBonus": 0.3,
        "affectedStats": ["anomalyDmgBonus"]
      },
      "affectsDisorder": false
    },
    {
      "id": "jane_doe-mindscape_2-adapt_to_the_enviroment",
      "source": "core",
      "sourceId": "jane_doe-mindscape_2",
      "label": "Adapt to the Environment (Mindscape Cinema N°2)",
      "description": "When Jane's attack hits an enemy in the Gnawed state, or when any squad member triggers Assault on an enemy in the Gnawed state, 15% of the enemy's DEF is ignored. Additionally, when Assault DMG triggers a CRIT, the CRIT DMG is increased by 50%.",
      "shortDescription": "All squad members' attacks ignore 15% of the target's DEF. All squad members' CRIT DMG from Assaults is increased by 50%",
      "target": "team",
      "flat": {
        "defShred": 0.15
      },
      "damageBonuses": [
        {
          "type": "assaultCritDmgBonus",
          "value": 0.5
        }
      ]
    },
    {
      "id": "jane_doe-mindscape_4-adapt_and_thrive",
      "source": "core",
      "sourceId": "jane_doe-mindscape_4",
      "label": "Adapt and Thrive (Mindscape Cinema N°2)",
      "description": "When any squad member triggers the Assault or Disorder effects, all squad members' Attribute Anomaly DMG is increased by 18%, lasting 15s.",
      "shortDescription": "All squad members' DMG form Attribute Anomalies and Disorders is increased by 18% for 15s",
      "target": "team",
      "flat": {
        "anomalyDmgBonus": 0.18,
        "disorderDmgBonus": 0.18
      }
    },
    {
      "id": "jane_doe-mindscape_6-shady_technique",
      "source": "core",
      "sourceId": "jane_doe-mindscape_6",
      "label": "Shady Technique (Mindscape Cinema N°6)",
      "description": "While in the Passion state, Jane's CRIT Rate increases by 20%, and CRIT DMG by 40%. After any squad member inflicts Assault, Jane instantly enters the Passion state, and gains max Passion Stream. When that instance of Assault triggers a critical hit, Jane performs an additional attack on the target, dealing Physical equal to 1,600% of her Anomaly Proficiency.",
      "shortDescription": "All squad members' CRIT DMG from Assaults is increased by 40%",
      "target": "team",
      "damageBonuses": [
        {
          "type": "assaultCritDmgBonus",
          "value": 0.4
        }
      ]
    }
  ],
