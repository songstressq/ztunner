  "ingameEffects": [
    {
      "id": "vivian_banshee-core_1-dirge_of_destiny",
      "source": "core",
      "sourceId": "vivian_banshee-core",
      "label": "Dirge of Destiny (Core Passive)",
      "description": "... When Basic Attack: Fluttering Frock - Suspension or Basic Attack: Featherbloom hits a target suffering any Attribute Anomaly, it will inflict Vivian's Prophecy, causing the target to take Ether DMG equal to 55% of Vivian's ATK every 0.55s. This DMG can trigger additional DMG from Attribute Anomalies. Vivian's Prophecy ends when the target is no longer suffering an Attribute Anomaly. When entering the battlefield, Vivian gains 2 Flight Feathers.",
      "shortDescription": "This ability is available in the Damage Calculator.",
      "infoOnly": true
    },
    {
      "id": "vivian_banshee-core_2-dirge_of_destiny",
      "source": "core",
      "sourceId": "vivian_banshee-core",
      "label": "Dirge of Destiny (Additional Ability)",
      "description": "When another character in your squad is an Anomaly character or shares the same attribute:\n\nWhenever another squad member applies an Attribute Anomaly to an enemy, Vivian will consume 1 Guard Feather to launch Basic Attack: Featherbloom on the target. This can trigger once every 0.5s. Corruption DMG dealt by all squad members and the Corruption status' Disorder DMG increases by 12%.",
      "shortDescription": "All squad members' DMG from Corruption and it's Disorder DMG are increased by 12%.",
      "target": "team",
      "damageBonuses": [
        {
          "type": "anomalyTypeDmg",
          "anomalyType": "corruption",
          "value": 0.12
        },
        {
          "type": "disorderTypeDmg",
          "anomalyType": "corruption",
          "value": 0.12
        }
      ]
    },
    {
      "id": "vivian_banshee-mindscape_1-alking_into_the_orchard_in_spring",
      "source": "mindscape",
      "sourceId": "vivian_banshee-mindscape_1",
      "label": "Walking Into the Orchard in Spring (Mindscape Cinema N°1)",
      "description": "When a total of 4 Guard Feathers are consumed, gain 1 Flight Feather. All Attribute Anomaly DMG and Disorder DMG received by targets under Vivian's Prophecy increases by 16%.",
      "shortDescription": "All squad members' DMG from Attribute Anomalies and Disorders is increased by 16%.",
      "target": "team",
      "flat": {
        "anomalyDmgBonus": 0.16,
        "disorderDmgBonus": 0.16
      }
    },
    {
      "id": "vivian_banshee-mindscape_2-stormy_night_stormy_night",
      "source": "mindscape",
      "sourceId": "vivian_banshee-mindscape_2",
      "label": "Stormy Night, Stormy Night (Mindscape Cinema N°2)",
      "description": "Vivian's Ether Anomaly Buildup Rate increases by 25%. The benefits of Abloom from Anomaly Proficiency are raised to 130% of the original value, and 15% of the target's All-Attribute RES is ignored.",
      "shortDescription": "Vivian's attacks ignore 15% of the target's All-Attribute RES",
      "target": "self",
      "perStack": {
        "fireResShred": 0.15,
        "iceResShred": 0.15,
        "electricResShred": 0.15,
        "physicalResShred": 0.15,
        "etherResShred": 0.15,
        "windResShred": 0.15
      }
    },
    {
      "id": "vivian_banshee-mindscape_4-the_wind_between_the_reeds",
      "source": "mindscape",
      "sourceId": "vivian_banshee-mindscape_4",
      "label": "The Wind Between the Reeds (Mindscape Cinema N°4)",
      "description": "Basic Attack: Fluttering Frock - Suspension and Basic Attack: Featherbloom will always CRIT on hit, and they will also increase Vivian's ATK by 12% for 12s. Repeated triggers reset the duration. When entering the battlefield, Vivian immediately gains 5 Guard Feathers.",
      "shortDescription": "Vivian's ATK is increased by 12% for 12s.",
      "target": "self",
      "flat": {
        "atkPercentRaw": 0.12
      }
    },
    {
      "id": "vivian_banshee-mindscape_6-vivian",
      "source": "mindscape",
      "sourceId": "vivian_banshee-mindscape_6",
      "label": "Vivian (Mindscape Cinema N°6)",
      "description": "Vivian's Ether DMG increases by 40%. When triggering a Perfect Dodge during Basic Attack: Noblewoman - Waltz's dash, or using EX Special Attack: Violet Requiem, gain 1 additional Flight Feather. Launching Basic Attack: Fluttering Frock - Suspension consumes all Guard Feathers, the downward attack's area of effect increases, and upon hit, triggers a special instance of Abloom. Each additional Guard Feather consumed will increase the proportion of additional Anomaly DMG dealt by that instance of Abloom, consuming a maximum of 5 Guard Feathers to increase the DMG up to a maximum of 5 times the original.",
      "shortDescription": "Vivian's Ether DMG is increased by 40%.",
      "target": "self",
      "damageBonuses": [
        {
          "type": "element",
          "element": "ether",
          "value": 0.4
        }
      ]
    }
  ],
