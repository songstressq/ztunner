  "ingameEffects": [
    {
      "id": "velina_airgid-core_1-breeze_in_bloom",
      "source": "core",
      "sourceId": "velina-core",
      "label": "Breeze in Bloom (Core Passive)",
      "description": "When Velina's initial Energy Regen exceeds 1.2, every additional 0.01 increases DMG dealt by 0.21%, up to a maximum increase of 35%, and increases Anomaly Mastery by 0.5, up to a maximum increase of 84. ...",
      "shortDescription": "Velina's DMG is increased based on her initial Energy Regen.",
