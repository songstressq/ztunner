  "ingameEffects": [
    {
      "id": "alice_thymefield-core_1-twin_rainbows_of_the_swordheart",
      "source": "core",
      "sourceId": "alice_thymefield-core",
      "label": "Twin Rainbows of the Swordheart (Core Passive)",
      "description": "After any squad member inflicts a Physical Anomaly on an enemy, Alice deals additional DMG each 0.95s of its active duration, equal to 2.5% of the original Physical Anomaly DMG. ...",
      "shortDescription": "This ability is available in the Anomaly Calculator.",
      "infoOnly": true
    },
    {
      "id": "alice_thymefield-core_2-twin_rainbows_of_the_swordheart",
      "source": "core",
      "sourceId": "alice_thymefield-core",
      "label": "Twin Rainbows of the Swordheart (Core Passive)",
      "description": "... If Disorder is triggered while the enemy is suffering a Physical Anomaly, for every 1s of remaining Physical Anomaly duration, the Disorder DMG multiplier increases by 18%, up to a max of 180%. ...",
      "shortDescription": "The target's Disorder DMG Multiplier suffered is increased by 18% for physical anomalies, stacking up to 10 times.",
      "target": "team",
      "perStack": {
        "disorderMultiplierBonus": 0.18
      },
      "maxStacks": 10,
      "condition": {
        "requiresDisorderAttribute": "physical"
      }
    },
    {
      "id": "alice_thymefield-core-mystery_hunt",
      "source": "core",
      "sourceId": "alice_thymefield-core",
      "label": "Mystery Hunt (Additional Ability)",
      "description": "When another character in your squad is an Anomaly or Support character:\n\nWhen any squad member triggers Disorder, Alice gains 30 Blade Etiquette. If Alice's Anomaly Mastery exceeds 140, each additional point grants her 1.6 Anomaly Proficiency. Upon entering the battlefield, Alice gains 300 Blade Etiquette. This effect can trigger once every 180s in Investigation Zone mode. ...",
      "shortDescription": "Alice's Anomaly Proficiency is incresed based on her current Anomaly Mastery.",
      "target": "self",
      "conditional": {
        "type": "currentStatBased",
        "basedOn": "anomalyMastery",
        "threshold": 140,
        "perUnit": 1,
        "perUnitBonus": 1.6,
        "maxBonus": 99999,
        "affectedStats": [
          "anomalyProficiency"
        ],
        "affectsAnomaly": false,
        "affectsDisorder": false
      }
    },
    {
      "id": "alice_thymefield-mindscape_1-paimful_of_cilantro",
      "source": "mindscape",
      "sourceId": "alice_thymefield-mindscape_1",
      "label": "Palmful of Cilantro (Mindscape Cinema N°1)",
      "description": "When Alice triggers a Polarized Assault, she gains 25 Blade Etiquette. When she triggers Assault against an enemy, the target's DEF is reduced by 20% for 30s.",
      "shortDescription": "The target's DEF is reduced by 20%.",
      "target": "team",
      "flat": {
        "defShred": 0.2
      }
    },
    {
      "id": "alice_thymefield-mindscape_2-sage_at_the_swords_tip",
      "source": "mindscape",
      "sourceId": "alice_thymefield-mindscape_2",
      "label": "Sage at the Sword's Tip (Mindscape Cinema N°2)",
      "description": "When Ultimate: Starfall Finale's Finishing Move hits an enemy, it triggers Polarized Assault. All squad members' Assault DMG increases by 15%. Disorder DMG against enemies suffering from Physical Anomaly increases by 15%.",
      "shortDescription": "All squad members' DMG from Assault and its Disorder DMG are increased by 15%.",
      "target": "team",
      "damageBonuses": [
        {
          "type": "anomalyTypeDmg",
          "anomalyType": "assault",
          "value": 0.15
        },
        {
          "type": "disorderTypeDmg",
          "anomalyType": "assault",
          "value": 0.15
        }
      ]
    },
    {
      "id": "alice_thymefield-mindscape_4-rosemary_on_her_lips",
      "source": "mindscape",
      "sourceId": "alice_thymefield-mindscape_4",
      "label": "Rosemary on Her Lips (Mindscape Cinema N°4)",
      "description": "Alice ignores 10% of the target's Physical RES. Enhanced Basic Attack: Celestial Overture accumulates 25% more Physical Anomaly Buildup.",
      "shortDescription": "Alice ignores 10% of the target's Physical RES.",
      "target": "self",
      "flat": {
        "physicalResShred": 0.1
      }
    },
    {
      "id": "alice_thymefield-mindscape_6-a_heart_of_thyme",
      "source": "mindscape",
      "sourceId": "alice_thymefield-mindscape_6",
      "label": "A Heart of Thyme (Mindscape Cinema N°6)",
      "description": "When Alice uses a third-stage charged Basic Attack: Starshine Waltz or Ultimate: Starfall Finale, she enters the Victory State for 30s. During this time, whenever any squad member lands a hit on a target, Alice will follow up with an extra attack against the target, dealing Physical DMG equal to 3,300% of her Anomaly Proficiency. This effect can trigger once every 1s and is guaranteed to CRIT. This effect can trigger up to 6 times. Gaining the Victory State again refreshes the available trigger count.",
      "shortDescription": "This ability is available in the Damage Calculator.",
      "infoOnly": true
    }
  ],
