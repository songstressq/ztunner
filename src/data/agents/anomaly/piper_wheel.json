  "ingameEffects": [
    {
      "id": "piper_wheel-core-synced_acceleration",
      "source": "core",
      "sourceId": "piper_wheel-core",
      "label": "Synced Acceleration (Aditional Ability)",
      "description": "When another character in your squad shares the same Attribute or Faction:\n\nWhen Piper has 20 or more stacks of Power, all squad members' DMG is increased by 18%.",
      "shortDescription": "All squad members' DMG is increased by 18% at full stacks.",
      "target": "team",
      "damageBonuses": [
        {
          "type": "global",
          "value": 0.18
        }
      ]
    },
    {
      "id": "piper_wheel-mindscape_1-leisure_moment",
      "source": "mindscape",
      "sourceId": "piper_wheel-mindscape_1",
      "label": "Leisure Moment (Mindscape Cinema N°1)",
      "description": "When Piper's Special Attack: Tire Spin, EX Special Attack: Engine Spin, or Ultimate hits an enemy with a spinning slash, there is a 50% chance to gain an additional stack of Power. The maximum stack limit of Power is increased to 30.",
      "shortDescription": "This mindscape cinema does not affect Piper's stats.",
      "infoOnly": true
    },
    {
      "id": "piper_wheel-mindscape_2-motivation",
      "source": "mindscape",
      "sourceId": "piper_wheel-mindscape_2",
      "label": "Motivation (Mindscape Cinema N°2)",
      "description": "During Special Attack: Tire Spin and EX Special Attack: Engine Spin, Piper's movement speed increases. When using Special Attack: One Trillion Tons, EX Special Attack: Really Heavy, or Ultimate to launch a downward smash that hits an enemy, the Physical DMG dealt by the move is increased by 10%. For every stack of Power, this buff is further increased by 1%.",
      "shortDescription": "The Physical DMG from Special Attack: One Trillion Tons, EX Special Attack: Really Heavy and piper-ultimate-hold_on_tight is increased by 10%, up to 40%.",
      "target": "self",
      "damageBonuses": [
        {
          "type": "elementExclusive",
          "element": "physical",
          "value": 0.1,
          "appliesTo": [
            "piper-special_attack-one_trillion_tons",
            "piper-ex_special_attack-really_heavy",
            "piper-ultimate-hold_on_tight"
          ]
        }
      ],
      "maxStacks": 4
    },
    {
      "id": "piper_wheel-mindscape_4-refined_techniques",
      "source": "mindscape",
      "sourceId": "piper_wheel-mindscape_4",
      "label": "Refined Techniques (Mindscape Cinema N°4)",
      "description": "Whenever a squad member inflicts an Attribute Anomaly on an enemy, Piper recovers 20 Energy. This effect can trigger every 30s.",
      "shortDescription": "This mindscape cinema does not affect Piper's stats.",
      "infoOnly": true
    },
    {
      "id": "piper_wheel-mindscape_6-mild_excitement",
      "source": "mindscape",
      "sourceId": "piper_wheel-mindscape_6",
      "label": "Mild Excitement (Mindscape Cinema N°6)",
      "description": "WIncreases the duration limit of EX Special Attack: Engine Spin by 2s and extends the duration of Power by 4s.",
      "shortDescription": "This mindscape cinema does not affect Piper's stats.",
      "infoOnly": true
    }
