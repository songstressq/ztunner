  "ingameEffects": [
    {
      "id": "hoshimi_miyabi-ultimate-lingering_snow",
      "source": "ultimate",
      "sourceId": "hoshimi_miyabi-ultimate",
      "label": "Lingering Snow (Ultimate)",
      "description": "When Decibel Rating is at Maximum, press Ultimate to activate:\n\nUnleashes powerful slashes at enemies ahead in a large area then pauses, before unleashing a Finishing Move, dealing massive Frost DMG. Upon activating this skill, gain 3 points of Fallen Frost and increase Ice DMG by 30% for 12s. Character is invulnerable while using this skill.",
      "shortDescription": "Miyabi's Ice DMG is increased by 30% for 12s.",
      "target": "self",
      "damageBonuses": [
        {
          "type": "element",
          "element": "ice",
          "value": 0.3
        }
      ]
    },
    {
      "id": "hoshimi_miyabi-core-searing_cold",
      "source": "core",
      "sourceId": "hoshimi_miyabi-core_1",
      "label": "Searing Cold (Core Passive)",
      "description": "... When Hoshimi Miyabi applies Frostbite to enemies with Icefire, it will consume the Icefire to trigger Frostburn - Break, dealing Frost DMG equal to 1500% of Hoshimi Miyabi's ATK and causing the target to enter the Frostburn state. All units accumulate 20% more Anomaly Buildup against enemies under the Frostburn state, but Hoshimi Miyabi cannot reapply Icefire to these enemies. The Frostburn state ends when Frostbite expires. While this state remains active, triggering another Attribute Anomaly will overwrite Frostbite and remove Frostburn. Upon triggering Frostburn - Break, Hoshimi Miyabi obtains 1 point of Fallen Frost. This effect can trigger once every 10s.",
      "shortDescription": "This ability is available in the Damage Calculator.",
      "infoOnly": true
    },
    {
      "id": "hoshimi_miyabi-core_1-bask_in_frost",
      "source": "core",
      "sourceId": "hoshimi_miyabi-core",
      "label": "Bask in Frost (Additional Ability)",
      "description": "When another character in your squad is a Support character or shares the same Faction: Basic Attack: Shimotsuki DMG increases by 60%. When any squad member triggers Disorder, Hoshimi Miyabi obtains 2 points of Fallen Frost and Basic Attack: Shimotsuki during the next Shimotsuki Stance will ignore 30% of the target's Ice RES.",
      "shortDescription": "Miyabi's DMG from Basic Attack: Shimotsuki is increased by 60%.",
      "target": "self",
      "damageBonuses": [
        {
          "type": "exclusive",
          "appliesTo": ["miyabi-basic_attack-shimotsuki"],
          "value": 0.6
        }
      ]
    },
    {
      "id": "hoshimi_miyabi-core_2-bask_in_frost",
      "source": "core",
      "sourceId": "hoshimi_miyabi-core",
      "label": "Bask in Frost (Additional Ability)",
      "description": "When another character in your squad is a Support character or shares the same Faction: Basic Attack: Shimotsuki DMG increases by 60%. When any squad member triggers Disorder, Hoshimi Miyabi obtains 2 points of Fallen Frost and Basic Attack: Shimotsuki during the next Shimotsuki Stance will ignore 30% of the target's Ice RES.",
      "shortDescription": "Miyabi's Basic Attack: Shimotsuki DMG ignores 30% of the target's Ice RES.",
      "target": "self",
      "exclusiveStatBonuses": [
        {
          "stat": "iceResShred",
          "type": "exclusive",
          "appliesTo": ["miyabi-basic_attack-shimotsuki"],
          "value": 0.3
        }
      ]
    },
    {
      "id": "hoshimi_miyabi-mindscape_1-frost_atop_the_snow",
      "source": "mindscape",
      "sourceId": "hoshimi_miyabi-mindscape_1",
      "label": "Frost Atop the Snow (Mindscape Cinema N°1)",
      "description": "While in Shimotsuki Stance, every 1 point of Fallen Frost consumed will allow Basic Attack: Shimotsuki to ignore 6% of DEF, stacking up to 6 times and lasting until Shimotsuki Stance ends. When a charge-level three slash of Basic Attack: Shimotsuki hits an enemy suffering Frostburn, it will immediately remove the Frostburn state and increase all squad members' Anomaly Buildup Rate by 20% for 10s.",
      "shortDescription": "Miyabi's Basic Attack: Shimotsuki ignores 6% of the target's DEF, stacking up to 6 times.",
      "target": "self",
      "exclusiveStatBonuses": [
        {
          "stat": "defShred",
          "type": "exclusive",
          "appliesTo": ["miyabi-basic_attack-shimotsuki"],
          "value": 0.06
        }
      ],
      "maxStacks": 6
    },
    {
      "id": "hoshimi_miyabi-mindscape_2-breath_technique",
      "source": "mindscape",
      "sourceId": "hoshimi_miyabi-mindscape_2",
      "label": "Breath Technique (Mindscape Cinema N°2)",
      "description": "Basic Attack: Kazahana and Dodge Counter DMG increases by 30%. Hoshimi Miyabi gains 1 point of Fallen Frost when the final move of the 5th hit of Basic Attack: Kazahana hits an enemy. Upon entering the battlefield, Hoshimi Miyabi immediately obtains 6 points of Fallen Frost and her CRIT Rate increases by 15%.",
      "shortDescription": "Miyabi's CRIT Rate is increased by 15% and her DMG from Basic Attack: Kazahana and Dodge Counter: Kan Suzume is increased by 30%. ",
      "target": "self",
      "flat": {
        "critRate": 0.15
      },
      "damageBonuses": [
        {
          "type": "exclusive",
          "appliesTo": [
            "miyabi-basic_attack-kazahana",
            "miyabi-dodge_counter-kan_suzume"
          ],
          "value": 0.3
        }
      ]
    },
    {
      "id": "hoshimi_miyabi-mindscape_4-rupture",
      "source": "mindscape",
      "sourceId": "hoshimi_miyabi-mindscape_4",
      "label": "Rupture (Mindscape Cinema N°4)",
      "description": "Frostburn - Break DMG increases by 30%. Upon triggering Frostburn - Break, Hoshimi Miyabi generates 250 more Decibels.",
      "shortDescription": "Miyabi's DMG from Frostburn - Break is increased by 30%.",
      "target": "self",
      "damageBonuses": [
        {
          "type": "exclusive",
          "appliesTo": ["miyabi-core-frostburn_break"],
          "value": 0.3
        }
      ]
    },
    {
      "id": "hoshimi_miyabi-mindscape_6-prodigious_talent",
      "source": "mindscape",
      "sourceId": "hoshimi_miyabi-mindscape_6",
      "label": "Prodigious Talent (Mindscape Cinema N°6)",
      "description": "During Shimotsuki Stance, Hoshimi Miyabi obtains Polar, which increases Basic Attack: Shimotsuki DMG by 30%. After obtaining Polar, Hoshimi Miyabi will automatically draw her blade and unleash powerful slashes based on the current charge level upon consuming Fallen Frost. Before Fallen Frost is completely depleted, the draw and slashes will not interrupt charging under Shimotsuki Stance. Each occurrence of Shimotsuki Stance can perform up to 3 draws and slashes.",
      "shortDescription": "Miyabi's DMG from Basic Attack: Shimotsuki is increased by 30%, stacking up to 3 times.",
      "target": "self",
      "damageBonuses": [
        {
          "type": "exclusive",
          "appliesTo": ["miyabi-core-frostburn_break"],
          "value": 0.3
        }
      ],
      "maxStacks": 3
    }
  ],
