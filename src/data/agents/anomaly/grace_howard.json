  "ingameEffects": [
    {
      "id": "fuck_her_titis",
      "source": "discSet",
      "label": "Grace Boobs (4-Piece Set)",
      "description": "When any squad member uses an EX Special Attack, the equipper's Anomaly Proficiency increases by 45 for 8s. If the character using the EX Special Attack is not the equipper, the equipper's Ether DMG is increased by 25%.",
      "shortDescription": "The equipper's Ether DMG is increased by 25% for 8s.",
      "target": "self",
      "damageBonuses": [
        {
          "type": "element",
          "element": "electric",
          "value": 0.3
        }
      ],
      "infoOnly": false
    },
    {
      "id": "grace_howard-core-tech_support_dept",
      "source": "core",
      "sourceId": "grace_howard-core",
      "label": "Tech Support Dept. (Additional Ability)",
      "description": "When another character in your squad shares the same Attribute or Faction:\n\nUpon hitting an enemy with an EX Special Attack, the next Shock effect inflicted on the target increases Shock DMG by 18%. This effect can stack up to 2 times, and each enemy can trigger it once per use. Resets when the Shock effect ends.",
      "shortDescription": "Grace's Shock DMG is increased by 18%, stacking up to 2 times.",
      "target": "self",
      "damageBonuses": [
        {
          "type": "anomalyTypeDmg",
          "anomalyType": "shock",
          "value": 0.18
        }
      ],
      "maxStacks": 2
    },
    {
      "id": "grace_howard-mindscape_1-recharge_chamber",
      "source": "mindscape",
      "sourceId": "grace_howard-mindscape_1",
      "label": "Recharge Chamber (Mindscape Cinema N°1)",
      "description": "When the 4th hit of Grace's Basic Attack hits an enemy, all squad members gain 0.25 Energy. Within the same move, this effect can grant a max of 2 Energy to all squad members.",
      "shortDescription": "This mindscape cinema does not affect Grace's stats.",
      "infoOnly": true
    },
    {
      "id": "grace_howard-mindscape_2-lighting_piercer",
      "source": "mindscape",
      "sourceId": "grace_howard-mindscape_2",
      "label": "Lightning Piercer (Mindscape Cinema N°2)",
      "description": "When Grace's grenade hits an enemy during a Basic Attack, Special Attack, or EX Special Attack, the target's Electric RES is reduced by 8.5%, and Electric Anomaly Buildup RES is reduced by 8.5%, lasting for 8s.",
      "shortDescription": "The target's Electric RES is reduced by 8.5% for 8s.",
      "target": "team",
      "flat": {
        "electricResShred": 0.085
      }
    },
    {
      "id": "grace_howard-mindscape_4-burst_capacitor",
      "source": "mindscape",
      "sourceId": "grace_howard-mindscape_4",
      "label": "Burst Capacitor (Mindscape Cinema N°4)",
      "description": "When Grace uses her EX Special Attack, she gains 6 stacks of Charge (max 6 stacks). When her Basic Attack: High-Pressure Spike or Dash Attack: Quick Inspection hits an enemy, 1 stack of Charge is consumed, increasing her Energy Generation Rate of the attack by 20%.",
      "shortDescription": "This mindscape cinema does not affect Grace's stats.",
      "infoOnly": true
    },
    {
      "id": "grace_howard-mindscape_6-detonation_trigger",
      "source": "mindscape",
      "sourceId": "grace_howard-mindscape_6",
      "label": "Detonation Trigger (Mindscape Cinema N°6)",
      "description": "When all Zap stacks are consumed to activate a Special Attack or EX Special Attack, Grace's skill is enhanced, tossing an extra grenade and increasing each grenade's DMG to 200%.",
      "shortDescription": "Grace's grenades from Special Attack: Obstruction Removal and EX Special Attack: Supercharged Obstruction Removal deal increased DMG.",
      "target": "self",
      "damageBonuses": [
        {
          "type": "exclusive",
          "appliesTo": [
            "grace-special_attack-obstruction_removal",
            "grace-ex_special_attack-supercharged_obstruction_removal"
          ],
          "value": 2
        }
      ]
    }
  ],
