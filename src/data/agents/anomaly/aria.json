  "ingameEffects": [
    {
      "id": "aria-core-innate_stage_presence",
      "source": "core",
      "sourceId": "aria-core",
      "label": "Innate Stage Presence (Core Passive)",
      "description": "Aria's Anomaly Proficiency increases by 90. If Aria's 3rd hit of Basic Attack: Perfect Pitch lands a heavy attack on an enemy suffering an Ether, Electric, Fire, Physical, or Ice Anomaly, it will trigger Abloom, which resolves an additional instance of Attribute Anomaly DMG. The additional DMG is calculated as 27.5%/14.3%/35.5%/2.5%/3.6% per 10 points of initial Anomaly Mastery of the original Anomaly DMG. If the target is Stunned, the DMG ratio is further increased by 50%.",
      "shortDescription": "Aria's Anomaly Proficiency is increased by 90.",
      "target": "self",
      "flat": {
        "anomalyProficiency": 90
      }
    },
    {
      "id": "aria-mindscape_1-energetic_sound_waves",
      "source": "mindscape",
      "sourceId": "aria-mindscape_1",
      "label": "Energetic Sound Waves (Mindscape Cinema N°1)",
      "description": "When Aria's Basic Attack, Special Attack, or EX Special Attack deals DMG to enemies, it ignores 10% of the target's Ether Anomaly Buildup RES. Additionally, when Aria triggers Abloom, it has a chance to trigger a critical hit. The base CRIT Rate is 25%, and CRIT DMG is 25%. If initial Anomaly Mastery exceeds 100, each additional point of initial Anomaly Mastery increases this effect's CRIT Rate by 0.5%.",
      "shortDescription": "This mindscape cinema does not affect Aria's stats.",
      "infoOnly": true
    },
    {
      "id": "aria-mindscape_2-fantastical_beat",
      "source": "mindscape",
      "sourceId": "aria-mindscape_2",
      "label": "Fantastical Beat (Mindscape Cinema N°2)",
      "description": "When Aria attacks or triggers Abloom, it ignores 16% of the target's DEF. During Moment of Delusion, attacks and Abloom triggers also ignore an additional 8% of the target's DEF.",
      "shortDescription": "Aria's attacks ignore 16% of the target's DEF, with an additional 8% during Moment of Delusion.",
      "target": "self",
      "baseStats": {
        "defShred": 0.16
      },
      "conditionalStats": {
        "stats": {
          "defShred": 0.08
        },
        "requiresBuff": "Moment of Delusion"
      }
    },
    {
      "id": "aria-mindscape_4-mechanical_angel",
      "source": "mindscape",
      "sourceId": "aria-mindscape_4",
      "label": "Mechanical Angel (Mindscape Cinema N°4)",
      "description": "When Aria triggers Abloom, she gains 4 Energy and 70 Decibels. This effect can trigger once every 10s.",
      "shortDescription": "This mindscape cinema does not affect Aria's stats.",
      "infoOnly": true
    },
    {
      "id": "aria-mindscape_6-fantastical_beat",
      "source": "mindscape",
      "sourceId": "aria-mindscape_6",
      "label": "Fantastical Beat (Mindscape Cinema N°6)",
      "description": "Upon entering the battlefield, Aria immediately gains 1,200 Decibels. In Investigation Zone mode, this effect can trigger once every 180s. After Aria enters Moment of Delusion, she will not exit it, and enhanced Basic Attack: Perfect Pitch and her Ultimate deal 40% increased Ether DMG. While in Moment of Delusion, when an enemy on the field enters an Anomaly state, Aria gains 1 stacks of All-Out Cheering. This effect can occur once every 6s. When gaining the All-Out Cheering effect, if already at 3 stacks of All-Out Cheering, any excess All-Out Cheering is converted into 2 Fandom Power and generated on the field.",
      "shortDescription": "Aria's Ether DMG from enhanced Basic Attack: Perfect Pitch and Ultimate: 100% Energy is increased by 40%.",
      "target": "self",
      "damageBonuses": [
