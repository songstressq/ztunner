    {
      "id": "remielle_dan-mindscape_1-naive_oath_1",
      "source": "mindscape",
      "sourceId": "remielle-mindscape_1",
      "label": "Naive Oath (Mindscape Cinema N°1)",
      "description": "Upon entering the battlefield, Remielle gains 3 special Voidflares. In Investigation Zone mode, this effect can trigger once every 180s. When Remielle triggers Luminize to deal DMG, she ignores 50% of the target's All-Attribute RES. When using Assist: Flower & Feather Dance, she gains 200 Decibels. This effect can trigger once every 18s. While Remielle is in the Phase Flow state, other squad members' Attribute Anomaly DMG increases by 10%.",
      "shortDescription": "Remielle's DMG from Luminize ignores 50% of the target's All-Attribute RES.",
      "target": "self",
      "flat": {
        "fireResShred": 0.5,
        "iceResShred": 0.5,
        "electricResShred": 0.5,
        "physicalResShred": 0.5,
        "etherResShred": 0.5,
        "windResShred": 0.5
      },
      "condition": {
        "appliesToLuminize": true
      },
      "linkedEffects": ["remielle_dan-mindscape_1-naive_oath_2"]
    },
    {
      "id": "remielle_dan-mindscape_1-naive_oath_2",
      "source": "mindscape",
      "sourceId": "remielle-mindscape_1",
      "label": "Naive Oath (Mindscape Cinema N°1)",
      "description": "Upon entering the battlefield, Remielle gains 3 special Voidflares. In Investigation Zone mode, this effect can trigger once every 180s. When Remielle triggers Luminize to deal DMG, she ignores 50% of the target's All-Attribute RES. When using Assist: Flower & Feather Dance, she gains 200 Decibels. This effect can trigger once every 18s. While Remielle is in the Phase Flow state, other squad members' Attribute Anomaly DMG increases by 10%.",
      "shortDescription": "The remaining squad members' DMG from Attribute Anomalies is increased by 10%.",
      "target": "team",
      "damageBonuses": [
        {
          "type": "anomalyDmgBonus",
          "value": 0.1
        }
