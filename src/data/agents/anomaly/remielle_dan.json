      }
    },
    {
      "id": "remielle-mindscape_6-lone_feathers_endless_flight",
      "source": "mindscape",
      "sourceId": "remielle-mindscape_6",
      "label": "Lone Feather's Endless Flight (Mindscape Cinema N°6)",
      "description": "When Remielle uses Basic Attack: Rainbow's End or Basic Attack: Fleeting Grace, Luminize is triggered 2 times. If the 4th hit of her Basic Attack lands against a target, Remielle gains 3 special Voidflares after the skill ends. Special Voidflares gained this way deal DMG equal to 25% of the special Voidflares gained upon entering the battlefield..",
      "shortDescription": "This mindscape cinema does not affect Remielle's stats.",
