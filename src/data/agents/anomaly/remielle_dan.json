      "condition": {
        "excludeOwner": true
      }
    },
    {
      "id": "remielle-mindscape_2-fall_into_the_noise_1",
      "source": "mindscape",
      "sourceId": "remielle-mindscape_2",
      "label": "Refringe Amplify (Mindscape Cinema N°2)",
      "description": "Remielle's Refringe Coefficient increases by 20%. When an Anomaly character in the squad deals Anomaly DMG to an enemy affected by Prismatic, the attack ignores 15% of the target's DEF. This effect persists for an additional 8s after Prismatic ends. While Remielle is in the Phase Flow state, the frequency at which she automatically attacks to apply Lumiflux Buildup to enemies increases.",
      "shortDescription": "Remielle's Refringe Coefficient is increased by 20%.",
      "target": "team",
      "flat": {
        "refringeCoefficient": 0.2
      },
      "linkedEffects": ["remielle-mindscape_2-fall_into_the_noise_2"]
    },
    {
      "id": "remielle-mindscape_2-fall_into_the_noise_2",
      "source": "mindscape",
      "sourceId": "remielle-mindscape_2",
      "label": "Refringe Amplify (Mindscape Cinema N°2)",
      "description": "Remielle's Refringe Coefficient increases by 20%. When an Anomaly character in the squad deals Anomaly DMG to an enemy affected by Prismatic, the attack ignores 15% of the target's DEF. This effect persists for an additional 8s after Prismatic ends. While Remielle is in the Phase Flow state, the frequency at which she automatically attacks to apply Lumiflux Buildup to enemies increases.",
      "shortDescription": "Anomaly squad members' DMG from Anomalies ignores the 15% of the target's DEF.",
      "target": "team",
