  "ingameEffects": [
    {
      "id": "nangong_yu-ultimate-ether_veil_delusion_reprise",
      "source": "ultimate",
      "sourceId": "nangong_yu-ultimate",
      "label": "Ether Veil: Delusion Reprise (Ultimate )",
      "description": "... While Ether Veil: Delusion Reprise is active, all squad members gain an additional 50 ATK for 30s. ...",
      "shortDescription": "All squad members' ATK is increased by 50 while Ether Veil: Delusion Reprise is active.",
      "target": "team",
      "flat": {
        "atkFlatRaw": 50
      }
    },
    {
      "id": "nangong_yu-core_1-prodigious_idol",
      "source": "core",
      "sourceId": "nangong_yu-core",
      "label": " Prodigious Idol (Core Passive)",
      "description": "Nangong Yu's Anomaly Proficiency increases by 120. When Nangong Yu's initial Anomaly Mastery exceeds 110, each point of initial Anomaly Mastery above that increases her Impact by 1. When an enemy is Stunned, each time any character triggers Abloom DMG, Disorder DMG, or inflicts an Attribute Anomaly on the enemy, the enemy gains 1 stacks of Vibrato. ...",
      "shortDescription": "Nangong Yu's Anomaly Proficiency is increased by 120.",
      "target": "self",
      "flat": {
        "anomalyProficiency": 120
      }
    },
    {
      "id": "nangong_yu-core_2-prodigious_idol",
      "source": "core",
      "sourceId": "nangong_yu-core",
      "label": " Prodigious Idol (Core Passive)",
      "description": "Nangong Yu's Anomaly Proficiency increases by 120. When Nangong Yu's initial Anomaly Mastery exceeds 110, each point of initial Anomaly Mastery above that increases her Impact by 1. When an enemy is Stunned, each time any character triggers Abloom DMG, Disorder DMG, or inflicts an Attribute Anomaly on the enemy, the enemy gains 1 stacks of Vibrato. ...",
      "shortDescription": "Nangong Yu's Impact is increased based on her initial Anomaly Mastery.",
      "target": "self",
      "conditional": {
        "type": "initialStatBased",
        "basedOn": "anomalyMastery",
        "threshold": 110,
        "maxStat": 99999,
        "baseBonus": 0,
        "perUnit": 1,
        "skillLevels": [
          {
            "level": 1,
            "maxBonus": 99999,
            "perUnitBonus": 1
          }
        ],
        "affectedStats": ["impactBaseRaw"]
      }
    },
    {
      "id": "nangong_yu-core_3-prodigious_idol",
      "source": "core",
      "sourceId": "nangong_yu-core",
      "label": " Prodigious Idol (Core Passive)",
      "description": "... When Nangong Yu's Basic Attack: Adorable Explosive Impact or EX Special Attack: The Unbearable Weight of Love hits an enemy, her Anomaly Buildup Rate increases by 35%, and her Daze dealt increases by 20%, and all squad members' DMG dealt increases by 25% for 30s. Repeated triggers reset the duration. While in combat, Nangong Yu restores 3.8 Downbeats/s. When any squad member inflicts an Attribute Anomaly on an enemy, Nangong Yu restores an additional 12 Downbeats. This effect can trigger once every 6s. Nangong Yu can hold up to 100 Downbeats, and starts with 30 Downbeats upon entering the battlefield.",
      "shortDescription": "All squad members' DMG is increased by 25% for 30s.",
      "target": "team",
      "damageBonuses": [
        {
          "type": "global",
          "value": 0.25
        }
      ]
    },
    {
      "id": "nangong_yu-mindscape_1-lazy_spotlight",
      "source": "mindscape",
      "sourceId": "nangong_yu-mindscape_1",
      "label": "Lazy Spotlight (Mindscape Cinema N°1)",
      "description": "When EX Special Attack: The Unbearable Weight of Love or Basic Attack: Adorable Explosive Impact hits an enemy, the enemy's All-Attribute RES decreases by 18% for 40s. Repeated triggers refresh the duration. When entering the battlefield, Nangong Yu's Downbeat is restored to the maximum. In Investigation Zone Mode, this effect can trigger once every 180s.",
      "shortDescription": "The target's All-Attribute RES is reduced by 18% for 50s.",
      "target": "team",
      "perStack": {
        "fireResShred": 0.18,
        "iceResShred": 0.18,
        "electricResShred": 0.18,
        "physicalResShred": 0.18,
        "etherResShred": 0.18,
        "windResShred": 0.18
      }
    },
    {
      "id": "nangong_yu-mindscape_2-painless_tears",
      "source": "mindscape",
      "sourceId": "nangong_yu-mindscape_2",
      "label": "Painless Tears (Mindscape Cinema N°2)",
      "description": "Each stack of Vibrato's additional Abloom DMG ratio increase from Core Passive: Prodigious Idol increases by an additional 10%. The Stun DMG Multiplier provided by Additional Ability: Angel Captain increases by an additional 30%. When the active character's Chain Attack heavy attack hits an enemy that is both Stunned and affected by an Attribute Anomaly, it triggers Polarity Disorder, dealing DMG equal to 25% of the original Disorder DMG. Each enemy can only trigger this effect once during the same Stun period.",
      "shortDescription": "This mindscape cinema does not affect Nangong Yu's stats.",
      "infoOnly": true
    },
    {
      "id": "nangong_yu-mindscape_4-accomplices_dance_step",
      "source": "mindscape",
      "sourceId": "nangong_yu-mindscape_4",
      "label": "Accomplice's Dance Step (Mindscape Cinema N°4)",
      "description": "Anomaly Proficiency increases by 40. The Anomaly Buildup of Basic Attack: Adorable Explosive Impact when hitting an enemy increases by 35%.",
      "shortDescription": "Nangong Yu's Anomaly Proficiency is increased by 40.",
      "target": "self",
      "flat": {
        "anomalyProficiency": 40
      }
    },
    {
      "id": "nangong_yu-mindscape_6-an_angels_delusion",
      "source": "mindscape",
      "sourceId": "nangong_yu-mindscape_6",
      "label": "An Angel's Delusion (Mindscape Cinema N°6)",
      "description": "Nangong Yu's attacks deal 50% more Daze. When the enemy is not Stunned, each time any character triggers Abloom DMG, Disorder DMG, or inflicts an Attribute Anomaly on them, the enemy gains 1 stacks of Vibrato: Modified. When hit by the heavy attack of EX Special Attack: The Unbearable Weight of Love or Basic Attack: Adorable Explosive Impact, they gain 1 stacks of Vibrato: Modified. When hit by the heavy attack of Ultimate: Meteor Shower, they gain 2 stacks of Vibrato: Modified.\n\nVibrato: Modified can stack up to 4 times. When the enemy becomes Stunned, all Vibrato: Modified stacks are cleared. When Vibrato: Modified is cleared, if the enemy is under an Ether, Electric, Fire, Physical, or Ice Anomaly, Nangong Yu triggers an instance of Abloom DMG on the target, dealing an additional instance of Attribute Anomaly DMG equal to 800%/400%/1,000%/70%/100% of the original Attribute Anomaly DMG. Each stack of Vibrato: Modified on the enemy increases this Abloom DMG ratio by an additional 25%. Vibrato: Modified cannot stack with Vibrato..",
      "shortDescription": "This mindscape cinema does not affect Nangong Yu's stats.",
      "infoOnly": true
    }
  ],
