  "ingameEffects": [
    {
      "id": "trigger-mindscape_1-sharpened_senses",
      "source": "mindscape",
      "sourceId": "trigger-mindscape_1",
      "label": "Sharpened Senses (Mindscape Cinema N°1)",
      "description": "The Stun DMG Multiplier applied through Core Passive: Soul-Searching Gaze is increased by an additional 20%. When activating Basic Attack: Harmonizing Shot, the cooldown is reduced to 2s. Purge gained upon hitting an enemy with the continuous fire or charged counter in Sniper Stance increases by 25%. Maximum Purge increases to 125.",
      "shortDescription": "This mindscape cinema does not affect Trigger's stats.",
      "infoOnly": true
    },
    {
      "id": "trigger-mindscape_2-ether_vision",
      "source": "mindscape",
      "sourceId": "trigger-mindscape_2",
      "label": "Ether Vision (Mindscape Cinema N°2)",
      "description": "Upon using an Aftershock, Trigger gains 1 stack of Hunter's Gaze. When executing a Finishing Move in Sniper Stance, Trigger gains 2 stacks of Hunter's Gaze. Each stack of Hunter's Gaze increases all squad members' CRIT DMG by 6%, stacking up to 4 times, and lasting 10s. Repeated triggers reset the duration.",
      "shortDescription": "All squad members' CRIT DMG is increased by 6% for 10s, stacking up to 4 times.",
      "target": "team",
      "perStack": {
        "critDmg": 0.06
      },
      "maxStacks": 4
    },
    {
      "id": "trigger-mindscape_4-concealment",
      "source": "mindscape",
      "sourceId": "trigger-mindscape_4",
      "label": "Concealment (Mindscape Cinema N°4)",
      "description": "When Trigger enters or extends Coordinated Support, while the state is active, the next time other squad members trigger Basic Attack: Harmonizing Shot or Basic Attack: Harmonizing Shot - Tartarus, it will trigger Disconnect upon hitting an enemy, dealing additional DMG equal to 200% of Trigger's ATK and inflict Daze equal to 120% of Trigger's Impact. This skill has a relatively high Interrupt Level.",
      "shortDescription": "This ability is available in the Damage Calculator.",
      "infoOnly": true
    },
    {
      "id": "trigger-mindscape_6-beyond_the_river_of_the_dead",
      "source": "mindscape",
      "sourceId": "trigger-mindscape_6",
      "label": "Beyond the River of the Dead (Mindscape Cinema N°6)",
      "description": "Upon entering the battlefield, Trigger gains 5 Armor Break Rounds. For every 25 Purge consumed, Trigger gains 1 additional Armor Break Round, up to a maximum of 5 rounds. While possessing Armor Break Rounds, when Trigger hits a target in Sniper Stance, 1 Armor Break Round is consumed to deal additional Electric DMG equal to 1,200% of Trigger's ATK. In addition, this instance of DMG is additionally increased by 50%. This effect can trigger once every 0.2s.",
      "shortDescription": "Trigger DMG from Armor Break Rounds is increased by 50%. Armor Break Rounds' additional DMG is available in the Damage Calculator.",
      "target": "self",
      "damageBonuses": [
        {
          "type": "exclusive",
          "appliesTo": ["trigger-mindscape-armor_break_rounds"],
          "value": 0.5
        }
      ]
    }
  ],
