      "source": "core",
      "sourceId": "ju_fufu-core",
      "label": "Fu-rocious Might (Core Passive)",
      "description": "... While in the Tiger's Roar state, character Chain Attack/Ultimate DMG increases by 20%/40%. The Tiger's Roar state lasts for 30s. Repeated triggers reset the duration. While Ju Fufu is in the Tiger's Roar state, Impact increases by 50.",
      "shortDescription": "All squad members' DMG from Chain Attacks is increased by 20% and DMG from Ultimates is increased by 40%.",
      "target": "team",
      "damageBonuses": [
        {
          "type": "skillType",
