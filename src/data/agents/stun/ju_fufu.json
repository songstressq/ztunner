  "ingameEffects": [
    {
      "id": "ju_fufu-core_1-fu_rocious_might",
      "source": "core",
      "sourceId": "ju_fufu-core",
      "label": "Fu-rocious Might (Core Passive)",
      "description": "... When Hu Wei hits an enemy and has at least 100 Might, and Ju Fufu is not the currently active character, Ju Fufu will launch Chain Attack: Suppressing Tiger Cauldron centered around the target enemy. Upon activation, all squad members gain the Tiger's Roar effect: CRIT DMG increases by 20%, and when Ju Fufu's initial ATK is greater than or equal to 2,800, every additional 100 ATK further increases CRIT DMG by 5%, up to a maximum additional increase of 30%. ...",
      "shortDescription": "All squad members' CRIT DMG is increased based on Ju Fufu's initial ATK.",
      "target": "team",
      "conditional": {
        "type": "initialStatBased",
        "basedOn": "atk",
        "threshold": 2800,
        "maxStat": 3400,
        "baseBonus": 0.2,
        "perUnit": 100,
        "perUnitBonus": 5,
