  "ingameEffects": [
    {
      "id": "qingyi-basic_attack-flash_connect",
      "source": "basic_attack",
      "sourceId": "qingyi-basic_attack",
      "label": "Flash Connect (Basic Attack)",
      "description": "When Qingyi deals Electric DMG with a skill, she accumulates Flash Connect Voltage. When Flash Connect Voltage reaches 75%, she will enter the Flash Connect state. When using her Basic Attack: Enchanted Moonlit Blossoms, Qingyi will consume all Flash Connect Voltage and exit the Flash Connect state. For every 1% of Flash Connect Voltage consumed over 75%, her Damage and Daze inflicted by this skill will be increased by 1%/0.5%. Basic Attack: Enchanted Moonlit Blossoms itself does not accumulate Flash Connect Voltage",
      "shortDescription": "Qingyi's DMG from Basic Attack: Enchanted Moonlit Blossoms is increased by 1% per Flash Connect Voltage consumed over 75%.",
      "target": "self",
      "damageBonuses": [
        {
          "type": "exclusive",
          "appliesTo": ["qingyi-basic_attack-enchanted_moonlit_blossoms"],
          "value": 0.01
        }
      ],
      "maxStacks": 25
    },
    {
      "id": "qingyi-core-three_verses_of_farewell_at_yang_pass",
      "source": "core",
      "sourceId": "qingyi_core",
      "label": "Three Verses of Farewell at Yang Pass (Additional Ability)",
      "description": "When another character in your squad is an Attack character or shares the same Faction:\n\nBasic Attacks deal 20% increased Daze. If Qingyi's Impact is greater than 120, each point over increases her ATK by 6, up to a maximum of 600.",
      "shortDescription": "Qingyi's ATK is increased based on her current Impact, up to a maximum of 600.",
      "target": "self",
      "conditional": {
        "type": "currentStatBased",
        "basedOn": "impact",
        "threshold": 120,
        "perUnit": 1,
        "perUnitBonus": 6,
        "maxBonus": 600,
        "affectedStats": ["atkFlatRaw"]
      }
    },
    {
      "id": "qingyi-mindscape_1_1-insulation_breakdown",
      "source": "mindscape",
      "sourceId": "qingyi-mindscape_1",
      "label": "Insulation Breakdown (Mindscape Cinema N°1)",
      "description": "When Qingyi enters combat, Flash Connect Voltage is instantly restored to its maximum, and the accumulation rate is increased by 30%. When using her Basic Attack: Enchanted Moonlit Blossoms, if Flash Connect Voltage is at its maximum, the attack will reduce the DEF of the enemy it hits by 15%, and Qingyi's CRIT Rate against that enemy will increase by 20% for 15s.",
      "shortDescription": "Qingyi's CRIT Rate is increased by 20% for 15s.",
      "target": "self",
      "flat": {
        "critRate": 0.2
      }
    },
    {
      "id": "qingyi-mindscape_1_2-insulation_breakdown",
      "source": "mindscape",
      "sourceId": "qingyi-mindscape_1",
      "label": "Insulation Breakdown (Mindscape Cinema N°1)",
      "description": "When Qingyi enters combat, Flash Connect Voltage is instantly restored to its maximum, and the accumulation rate is increased by 30%. When using her Basic Attack: Enchanted Moonlit Blossoms, if Flash Connect Voltage is at its maximum, the attack will reduce the DEF of the enemy it hits by 15%, and Qingyi's CRIT Rate against that enemy will increase by 20% for 15s.",
      "shortDescription": "The target's DEF is reduced by 15%.",
      "target": "self",
      "flat": {
        "defShred": 0.15
      }
    },
    {
      "id": "qingyi-mindscape_2-minimal_effort_maximum_impact",
      "source": "mindscape",
      "sourceId": "qingyi-mindscape_2",
      "label": "Minimal Effort, Maximum Impact (Mindscape Cinema N°2)",
      "description": "The Stun DMG Multiplier increase provided by each stack of Subjugation in Core Passive: Eternal Seasons increases to 135% of its original value. When Qingyi's attack hits an enemy and the stacks of Subjugation she applies reaches its maximum stacks, her Daze dealt to the target increases by 15%.",
      "shortDescription": "This mindscape cinema does not affect Qingyi's stats.",
      "infoOnly": true
    },
    {
      "id": "qingyi-mindscape_4-stable_arc_barrier",
      "source": "mindscape",
      "sourceId": "qingyi-mindscape_4",
      "label": "Stable Arc Barrier (Mindscape Cinema N°4)",
      "description": "Upon entering or exiting Flash Connect state, gain a shield equal to 10% of Qingyi's Max HP. If a previous shield is still active when the shield effect refreshes, Qingyi generates 5 Energy. This Energy Generation effect can be triggered once every 10s.",
      "shortDescription": "This mindscape cinema does not affect Qingyi's stats.",
      "infoOnly": true
    },
    {
      "id": "qingyi-mindscape_6_1-eight_meridians",
      "source": "mindscape",
      "sourceId": "qingyi-mindscape_6",
      "label": "Eight Meridians (Mindscape Cinema N°6)",
      "description": "The Interrupt Level of Basic Attack: Enchanted Moonlit Blossoms is greatly increased, and the CRIT DMG is increased by an additional 100%. When Qingyi hits an enemy with her Basic Attack: Enchanted Moonlit Blossoms, the target's Attribute DMG RES is reduced by 20% for 15s.",
      "shortDescription": "Qingyi's CRIT DMG from Basic Attack: Enchanted Moonlit Blossoms is increased by 100%.",
      "target": "self",
      "exclusiveStatBonuses": [
        {
          "stat": "critDmg",
          "type": "exclusive",
          "appliesTo": ["qingyi-basic_attack-enchanted_moonlit_blossoms"],
          "value": 1
        }
      ]
    },
    {
      "id": "qingyi-mindscape_6_2-eight_meridians",
