  "ingameEffects": [
    {
      "id": "lycaon-core-metallic_paws",
      "source": "core",
      "sourceId": "lycaon-core",
      "label": "Metallic Paws (Core Passive)",
      "description": "When Lycaon charges his Basic Attack to completion, the attack deals 80% increased Daze. When EX Special Attack: Thrill of the Hunt or Assist Follow-Up: Vengeful Counterattack hits an enemy, the target's Ice DMG RES decreases by 25% for 30s.",
      "shortDescription": "The target's Ice RES is reduced by 25% for 30s.",
      "target": "team",
      "flat": {
        "iceResShred": 0.25
      }
    },
    {
      "id": "lycaon-mindscape_1-full_moon_momentum",
      "source": "mindscape",
      "sourceId": "lycaon-mindscape_1",
      "label": "Full Moon Momentum (Mindscape Cinema N°1)",
      "description": "When Lycaon's EX Special Attack: Thrill of the Hunt hits an enemy, the attack's Daze increases by 12%. This effect can trigger once every 8s. When he charges his EX Special Attack: Thrill of the Hunt to completion, this buff will increase by an additional 10%.",
      "shortDescription": "This mindscape cinema does not affect Lycaon's stats.",
      "infoOnly": true
    },
    {
      "id": "lycaon-mindscape_2-energy_feedback",
      "source": "mindscape",
      "sourceId": "lycaon-mindscape_2",
      "label": "Energy Feedback (Mindscape Cinema N°2)",
      "description": "When Stunning an enemy or triggering a squad member's Chain Attack, Lycaon gains 5 Energy. Can trigger once every 1s.",
      "shortDescription": "This mindscape cinema does not affect Lycaon's stats.",
      "infoOnly": true
    },
    {
      "id": "lycaon-mindscape_4-graceful_demeanor",
      "source": "mindscape",
      "sourceId": "lycaon-mindscape_4",
      "label": "Graceful Demeanor (Mindscape Cinema N°4)",
      "description": "If Lycaon is attacked while using a Basic Attack or Special Attack, he will immediately gain a Shield equal to 7.5% of his Max HP, lasting for 15s. During the Shield's duration, his Anti-Interrupt level is increased. This effect can trigger once every 15s.",
      "shortDescription": "This mindscape cinema does not affect Lycaon's stats.",
      "infoOnly": true
    },
    {
      "id": "lycaon-mindscape_6-ruthless_humter",
      "source": "mindscape",
      "sourceId": "lycaon-mindscape_6",
      "label": "Ruthless Hunter (Mindscape Cinema N°6)",
      "description": "When a charged attack hits an enemy, the target suffers 10% increased DMG from Lycaon, stacking up to 5 times and lasting 12s. Only one stack can be gained per skill use, and repeated triggers reset the duration.",
      "shortDescription": "Lycaon's DMG is increased by 10% for 12s, stacking up to 5 times.",
      "target": "self",
      "damageBonuses": [
        {
          "type": "global",
          "value": 0.1
        }
      ],
      "maxStacks": 5
    }
  ],
