      }
    },
    {
      "id": "norma_hollowell-core_2-precise_guidance",
      "source": "core",
      "sourceId": "norma-core",
      "label": "Precise Guidance (Core Passive)",
      "description": "... Norma gains additional ATK based on her Sheer Force. Every 1 point of Sheer Force increases her ATK by 1.25, up to a maximum increase of 1,200 ATK. ...",
      "shortDescription": "Norma's ATK is increased based on her current Sheer Force.",
      "target": "self",
      "conditional": {
        "type": "currentStatBased",
        "basedOn": "sheerForce",
        "threshold": 0,
        "perUnit": 1,
        "perUnitBonus": 1.25,
        "maxBonus": 1200,
        "affectedStats": ["atkFlatRaw"]
      }
    },
    {
      "id": "norma_hollowell-core_1-advantage_in_numbers",
      "source": "core",
      "sourceId": "norma-core",
      "label": "Advantage in Numbers (Additional Ability)",
      "description": "... While En-nah Barrage is active, Norma's ATK increases by 44. This effect scales with character level, increasing by 14 per level, up to a maximum increase of 870. ...",
      "shortDescription": "Norma's ATK is increased by 870 while En-nah Barrage is active.",
      "target": "self",
      "flat": {
        "atkFlatRaw": 870
      }
    },
    {
      "id": "norma_hollowell-core_2-advantage_in_numbers",
      "source": "core",
      "sourceId": "norma-core",
      "label": "Advantage in Numbers (Additional Ability)",
      "description": "... While En-Nah Barrage is active, DMG dealt by all squad members increases by 20%. ...",
      "shortDescription": "All squad members' DMG is increased by 20% while En-nah Barrage is active.",
      "target": "team",
      "damageBonuses": [
        {
          "type": "global",
          "value": 0.2
        }
      ]
    },
    {
      "id": "norma_holowell-mindscape_1-visionary_extremism",
      "source": "mindscape",
      "sourceId": "norma_holowell-mindscape_1",
      "label": "Visionary Extremism (Mindscape Cinema N°1)",
      "description": "The duration of the En-Nah Turret's missile bay deployed by EX Special Attack: Explosive Experiment increases to 12s. When an Armor-Piercing Warhead or High-Explosive Warhead from any skill hits an enemy, the target's All-Attribute RES is reduced by 15% for 15s.",
      "shortDescription": "The target's All-Attribute RES is reduced by 18% for 15s.",
      "target": "team",
      "perStack": {
        "fireResShred": 0.15,
        "iceResShred": 0.15,
        "electricResShred": 0.15,
        "physicalResShred": 0.15,
        "etherResShred": 0.15,
        "windResShred": 0.15
      }
    },
    {
      "id": "norma_holowell-mindscape_2-axiom_of_universal_unity",
      "source": "mindscape",
      "sourceId": "norma_holowell-mindscape_2",
      "label": "Axiom of Universal Unity (Mindscape Cinema N°2)",
      "description": "The Stun DMG Multiplier granted by each stack of Tech Divide in Norma's Additional Ability: Advantage in Numbers is increased to 6%. When Norma uses Basic Attack: Hat Trick while in combat, she gains 25 Energy. This effect can trigger once every 20s.",
      "shortDescription": "This mindscape cinema does not affect Norma's stats.",
      "infoOnly": true
    },
    {
      "id": "norma_holowell-mindscape_4-bangboo_superiority_theory",
      "source": "mindscape",
      "sourceId": "norma_holowell-mindscape_4",
      "label": "Bangboo Superiority Theory (Mindscape Cinema N°4)",
      "description": "When Norma consumes Preheated Chamber to trigger a Chain Attack, both Norma and the corresponding Agent gain 200 Decibels.",
      "shortDescription": "This mindscape cinema does not affect Norma's stats.",
      "infoOnly": true
    },
    {
      "id": "norma_holowell-mindscape_6-the_primary_cause_of",
      "source": "mindscape",
      "sourceId": "norma_holowell-mindscape_6",
      "label": "The Primary Cause of Genius (Mindscape Cinema N°6)",
      "description": "After any squad member Stuns an enemy, Norma will continuously summon missiles to bombard random enemies on the field for 6s. A missile is launched every 0.75s, dealing Fire DMG equal to 200% of Norma's ATK to enemies within the area. This DMG is considered Ultimate DMG. Repeated triggers reset the duration. This effect can trigger once every 30s. The Daze inflicted by Armor-Piercing Warhead increases by 30%, and the DMG dealt by High-Explosive Warhead increases by 30%.",
      "shortDescription": "Norma's DMG from High-Explosive Warheads is increased by 30%.",
      "target": "self",
      "damageBonuses": [
        {
          "type": "hitExclusive",
          "skillId": "norma_holowell-ex_special_attack-en_nah_barrage",
          "hitNames": [
            "High-Explosive Warhead DMG Multiplier",
            "Extended Shot High-Explosive Warhead DMG Multiplier Per Sec"
          ],
          "value": 0.3
        },
        {
          "type": "hitExclusive",
          "skillId": "norma_holowell-ex_special_attack-explosive_experiment",
          "hitName": "Additional Armor-Piercing Warhead DMG Multiplier",
          "value": 0.3
        }
      ]
    }
  ],
