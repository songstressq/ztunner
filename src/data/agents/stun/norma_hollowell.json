  "ingameEffects": [
    {
      "id": "norma_hollowell-core_1-precise_guidance",
      "source": "core",
      "sourceId": "norma-core",
      "label": "Precise Guidance (Core Passive)",
      "description": "When initial CRIT Rate exceeds 50%, every additional 1% increases her CRIT DMG by 1.7%, up to a maximum increase of 85%. ...",
      "shortDescription": "Norma's CRIT DMG is increased based on her initial CRIT Rate.",
