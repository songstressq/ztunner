  "ingameEffects": [
    {
      "id": "anby_demara-mindscape_1-rapid_charge_mode",
      "source": "mindscape",
      "sourceId": "anby_demara-mindscape_1",
      "label": "Rapid Charge Mode (Mindscape Cinema N°1)",
      "description": "When the 4th-hit of Anby's Basic Attack hits an enemy, her Energy Generation Rate is increased by 12% for 30s.",
      "shortDescription": "This mindscape cinema does not affect Anby's stats.",
      "infoOnly": true
    },
    {
      "id": "anby_demara-mindscape_2-precision_discharge",
      "source": "mindscape",
      "sourceId": "anby_demara-mindscape_2",
      "label": "Precision Discharge (Mindscape Cinema N°2)",
      "description": "When Basic Attack: Thunderbolt hits a Stunned enemy, its DMG is increased by 30%. When Anby's EX Special Attack hits an enemy that is not Stunned, the Daze inflicted is increased by 10%.",
      "shortDescription": "Anby's DMG from Basic Attack: Thunderbolt is increased by 30%.",
      "target": "self",
      "damageBonuses": [
        {
          "type": "exclusive",
          "appliesTo": ["anby-basic_attack-thunderbolt"],
          "value": 0.3
        }
      ]
    },
    {
      "id": "anby_demara-mindscape_4-conducting_charge",
      "source": "mindscape",
      "sourceId": "anby_demara-mindscape_4",
      "label": "Conducting Charge (Mindscape Cinema N°4)",
      "description": "When Anby launches a Chain Attack or uses her Ultimate, off-field Electric characters recover 3 Energy. For every 12% of Anby's Energy Generation Rate, recover an additional 2 Energy, up to a maximum of 6 additional Energy.",
      "shortDescription": "This mindscape cinema does not affect Anby's stats.",
      "infoOnly": true
    },
    {
      "id": "anby_demara-mindscape_6-charging_field",
      "source": "mindscape",
      "sourceId": "anby_demara-mindscape_6",
      "label": "Charging Field (Mindscape Cinema N°6)",
      "description": "When Anby uses her EX Special Attack, she gains 8 stacks of Charge (max 8 stacks). When she hits an enemy with her Basic Attack or Dash Attack, 1 stack of Charge is consumed, increasing that attack's DMG by 45%.",
      "shortDescription": "Anby's DMG from Basic Attacks or Dash Attacks is increased by 45%.",
      "target": "self",
      "damageBonuses": [
        {
          "type": "exclusive",
          "appliesTo": [
            "anby-basic_attack-turbo_volt",
            "anby-basic_attack-thunderbolt",
            "anby-dash_attack-taser_blast"
          ],
          "value": 0.45
        }
      ]
    }
  ],
