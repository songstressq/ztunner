  "ingameEffects": [
    {
      "id": "dialyn-core-five_star_service_hotline",
      "source": "core",
      "sourceId": "dialyn-core",
      "label": "Five-Star Service Hotline (Core Passive)",
      "description": "Upon entering the battlefield, Dialyn starts with 60 Positive Reviews. If her initial CRIT Rate surpasses 50%, her Impact increases by 2 for each additional 1%, up to a maximum increase of 100. ...",
      "shortDescription": "Dialyn's Impact is increased based on her initial CRIT Rate.",
      "target": "self",
      "conditional": {
        "type": "initialStatBased",
        "basedOn": "critRate",
        "threshold": 50,
        "maxStat": 100,
        "baseBonus": 0,
        "perUnit": 1,
        "skillLevels": [
          {
            "level": 1,
            "maxBonus": 100,
            "perUnitBonus": 2
          }
        ],
        "affectedStats": ["impactBaseRaw"]
      }
    },
    {
      "id": "dialyn-core_1-external_line",
      "source": "core",
      "sourceId": "dialyn-core",
      "label": "External Line (Additional Ability)",
      "description": "When another character in your squad is an Attack or Rupture character:\n\nDialyn's EX Special Attack CRIT DMG is increased by 50%. ....",
      "shortDescription": "Dialyn's CRIT DMG from EX Special Attacks is increased by 50%.",
      "target": "self",
      "exclusiveStatBonuses": [
        {
          "stat": "critDmg",
          "type": "exclusive",
          "appliesTo": [
            "dialyn-ex_special_attack-get_lost",
            "dialyn-ex_special_attack-rock",
            "dialyn-ex_special_attack-scissors",
            "dialyn-ex_special_attack-paper"
          ],
          "value": 0.5
        }
      ]
    },
    {
      "id": "dialyn-core_2-external_line",
      "source": "core",
      "sourceId": "dialyn-core",
      "label": "External Line (Additional Ability)",
      "description": "... When an EX Special Attack or Ultimate is activated, all squad members gain the Overwhelmingly Positive effect. While Overwhelmingly Positive is active, DMG dealt is increased by 40% for 15s. When Dialyn uses an EX Special Attack or Ultimate while Overwhelmingly Positive is active, if the remaining duration of Overwhelmingly Positive is less than 35s, its duration is extended by 10s ...",
      "shortDescription": "All squad members' DMG is increased by 40% for 15s.",
      "target": "team",
      "damageBonuses": [
        {
          "type": "global",
          "value": 0.4
        }
      ]
    },
    {
      "id": "dialyn-core_3-external_line",
      "source": "core",
      "sourceId": "dialyn-core",
      "label": "External Line (Additional Ability)",
      "description": "... When a heavy attack from EX Special Attack: Rock, EX Special Attack: Scissors, or EX Special Attack: Paper! hits, additional DMG is dealt based on the previous squad member's Specialty:\n\nIf the squad member is an Attack Agent, EX Special Attack: Rock, EX Special Attack: Scissors, and EX Special Attack: Paper! deal additional DMG equal to 320% of that Attack Agent's ATK.\n\nIf the squad member is a Rupture Agent, EX Special Attack: Rock, EX Special Attack: Scissors, and EX Special Attack: Paper! deal additional DMG equal to 400% of that Rupture Agent's Sheer Force.",
      "shortDescription": "This ability is available in the Damage Calculator.",
      "target": "self",
      "requiresManualTarget": true,
      "referenceStatEffect": {
        "type": "referenceStat",
        "referenceSlot": "previous",
        "statToRead": "atk",
        "multiplier": 3.2,
        "appliesTo": {
          "skillIds": [
            "dialyn-ex_special_attack-get_lost",
            "dialyn-ex_special_attack-rock",
            "dialyn-ex_special_attack-scissors",
            "dialyn-ex_special_attack-paper"
          ]
        },
        "specialtyMultipliers": {
          "Attack": 3.2,
          "Rupture": 4
        },
        "specialtyStats": {
          "Attack": "atk",
          "Rupture": "sheerForce"
        }
      }
    },
    {
      "id": "dialyn-mindscape_1-boundless_hospitality",
      "source": "mindscape",
      "sourceId": "dialyn-mindscape_1",
      "label": "Boundless Hospitality (Mindscape Cinema N°1)",
      "description": "The amount of Positive Reviews accumulated each second and gained when EX Special Attack: Rock, EX Special Attack: Scissors, or EX Special Attack: Paper! hits an enemy increase by 16%. While the Overwhelmingly Positive effect is active, characters ignore 15% of enemy All-Attribute RES.",
      "shortDescription": "All squad members' attacks ignore 15% of the target All-Attribute RES.",
      "target": "team",
      "perStack": {
        "fireResShred": 0.15,
        "iceResShred": 0.15,
        "electricResShred": 0.15,
        "physicalResShred": 0.15,
        "etherResShred": 0.15,
        "windResShred": 0.15
      }
    },
    {
      "id": "dialyn-mindscape_2-24_7_hotline",
      "source": "mindscape",
      "sourceId": "dialyn-mindscape_2",
      "label": "24/7 Hotline (Mindscape Cinema N°2)",
      "description": "Enemies affected by Malicious Complaint gain an additional 20% Stun DMG Multiplier when Stunned. All units deal 15% increased DMG to targets affected by Malicious Complaint.",
      "shortDescription": "All squad members' DMG is increased by 15%.",
      "target": "team",
      "damageBonuses": [
        {
          "type": "global",
          "value": 0.15
        }
      ]
    },
    {
      "id": "dialyn-mindscape_4-the_past_never_fades",
      "source": "mindscape",
      "sourceId": "dialyn-mindscape_4",
      "label": "The Past Never Fades (Mindscape Cinema N°4)",
      "description": "Upon entering combat, Dialyn recovers 20 Energy. This effect can trigger once every 180s in Investigation Zone Mode. While the Overwhelmingly Positive effect is active, Dialyn's ATK increases by 500.",
      "shortDescription": "Dialyn's ATK is increased by 500.",
      "target": "self",
      "flat": {
        "atkFlatRaw": 500
      }
    },
    {
      "id": "dialyn-mindscape_6-truth",
      "source": "mindscape",
      "sourceId": "dialyn-mindscape_6",
      "label": "Truth (Mindscape Cinema N°6)",
      "description": "When an ally enters the field with an Ultimate through the Core Passive's effect, that ally gains the Aftertone effect. With this effect, landing an attack causes Dialyn to deal an additional instance of Physical DMG equal to 480% of Dialyn's ATK. This DMG is treated as EX Special Attack DMG, and can trigger once every second, up to 12 times. Gaining Aftertone again refreshes its trigger count. Only one ally can have Aftertone at a time.",
      "shortDescription": "This ability is available in the Damage Calculator.",
      "infoOnly": true
    }
  ],
