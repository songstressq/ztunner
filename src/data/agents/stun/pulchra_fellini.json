  "ingameEffects": [
    {
      "id": "pulchra-core-bussiness_partner",
      "source": "core",
      "sourceId": "pulchra-core",
      "label": "Business Partner (Additional Ability)",
      "description": "When another character in your squad is an Attack or Rupture character or shares the same Faction: When Pulchra hits enemies with Special Attack: Rending Claw - Nightmare Shadow, EX Special Attack: Rending Claw - Flashstep, Assist Follow-Up: Independent Pricing, Chain Attack: Hey, Didn't Expect That, Right?, or Ultimate: Oh, Time to Play?, it applies the Binding Trap effect for 15s. After applying Binding Trap, all units' Aftershock DMG against the target is increased by 30%.",
      "shortDescription": "All squad members' DMG from Aftershocks is increased by 30%.",
      "target": "team",
      "damageBonuses": [
        {
          "type": "element",
          "element": "aftershock",
          "value": 0.3
        }
      ]
    },
    {
      "id": "pulchra-mindscape_1-self_interest",
      "source": "mindscape",
      "sourceId": "pulchra-mindscape_1",
      "label": "Self-Interest (Mindscape Cinema N°1)",
      "description": "When dealing DMG to enemies affected by Binding Trap, increase own CRIT Rate by 10%.",
      "shortDescription": "Pulchra's CRIT Rate is increased by 10%.",
      "target": "self",
      "flat": {
        "critRate": 0.1
      }
    },
    {
      "id": "pulchra-mindscape_2-opportunistic",
      "source": "mindscape",
      "sourceId": "pulchra-mindscape_2",
      "label": "Opportunistic (Mindscape Cinema N°2)",
      "description": "While in the Hunter's Gait state from Core Passive: Hunter's Instinct, Pulchra's ATK is increased by an additional 10%.",
      "shortDescription": "Pulchra's ATK is increased by 10%.",
      "target": "self",
      "flat": {
        "atkPercentRaw": 0.1
      }
    },
    {
