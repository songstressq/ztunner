  "ingameEffects": [
    {
      "id": "koleda_belobog-core-belobog_management",
      "source": "core",
      "sourceId": "koleda_belobog-core",
      "label": "Belobog Management (Additional Passive)",
      "description": "WWhen another character in your squad shares the same Attribute or Faction or is a Rupture character: When the explosion from Koleda's EX Special Attack hits an enemy, it applies a debuff to the target. While the target is Stunned, Chain Attacks deal 35% more DMG to the target. This effect can stack up to 2 times and resets when the Stunned effect ends.",
      "shortDescription": "All squad members' DMG from Chain Attacks is increased by 35%, stacking up to 2 times.",
      "target": "team",
      "damageBonuses": [
        {
          "type": "skillType",
          "skillType": "chain",
          "value": 0.35
        }
      ],
      "maxStacks": 2
    },
    {
      "id": "koleda_belobog-mindscape_1-beat_of_the_hammer",
      "source": "mindscape",
      "sourceId": "koleda_belobog-mindscape_1",
      "label": "Beat of the Hammer (Mindscape Cinema N°1)",
      "description": "After the 2nd or 4th hit of Koleda's Basic Attack or her enhanced Basic Attack, quickly use a Special Attack or EX Special Attack to increase the Daze dealt by 15%.",
      "shortDescription": "This mindscape cinema does not affect Koleda's stats.",
      "infoOnly": true
    },
    {
      "id": "koleda_belobog-mindscape_2-kinetic_recovery",
      "source": "mindscape",
      "sourceId": "koleda_belobog-mindscape_2",
      "label": "Kinetic Recovery (Mindscape Cinema N°2)",
      "description": "When Koleda's EX Special Attack hits an enemy, she recovers 60 Energy. Can trigger once every 45s.",
      "shortDescription": "This mindscape cinema does not affect Koleda's stats.",
      "infoOnly": true
    },
    {
      "id": "koleda_belobog-mindscape_4-furnaces_glow",
      "source": "mindscape",
      "sourceId": "koleda_belobog-mindscape_4",
      "label": "Furnace's Glow (Mindscape Cinema N°4)",
      "description": "Koleda gains one stack of Charge (max 2 stacks) when consuming Furnace Fire to use her Enhanced Basic Attack. When her Chain Attack: Natural Disaster or Ultimate: Hammerquake hits an enemy, she consumes all stacks of Charge to increase the attack's DMG by 18% per stack.",
      "shortDescription": "Koleada's DMG from Chain Attack: Natural Disaster and Ultimate: Hammerquake is increased by 18%, stacking up to 2 times.",
      "target": "self",
      "damageBonuses": [
        {
          "type": "exclusive",
          "appliesTo": [
            "koleda-chain_attack-natural_disaster",
            "koleda-ultimate-hammerquake"
          ],
          "value": 0.18
        }
      ],
      "maxStacks": 2
    },
    {
      "id": "koleda_belobog-mindscape_6-saturated_blast",
      "source": "mindscape",
      "sourceId": "koleda_belobog-mindscape_6",
      "label": "Saturated Blast (Mindscape Cinema N°6)",
      "description": "When EX Special Attack, Chain Attack, or Ultimate triggers an explosion that hits an enemy, it deals additional DMG equal to 360% of Koleda's ATK.",
      "shortDescription": "This ability is available in the Damage Calculator.",
      "infoOnly": true
    }
  ],
